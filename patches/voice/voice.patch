+import { expect, test } from 'bun:test'
+import { mkdtempSync, rmSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import { CallLog, ending, summary, usage, type CallRecord } from './calls.ts'
+
+function scratch() {
+  const dir = mkdtempSync(join(tmpdir(), 'calls-'))
+  return { calls: new CallLog(dir), [Symbol.dispose]: () => rmSync(dir, { recursive: true }) }
+}
+
+const record = (id: string, started: string, extra: Partial<CallRecord> = {}): CallRecord => ({
+  id,
+  started,
+  from: 'app',
+  turns: [
+    { who: 'voice', at: 900, text: 'Hey.' },
+    { who: 'you', at: 3400, text: 'Is the build green?' },
+  ],
+  tasks: [],
+  ...extra,
+})
+
+test('the list is newest first, without the turns, with how long and how it began', () => {
+  using log = scratch()
+  const { calls } = log
+  calls.save(record('a', '2026-10-13T01:00:00.000Z', { ended: '2026-10-13T01:04:30.000Z' }))
+  calls.save(record('b', '2026-10-13T03:00:00.000Z'))
+  expect(calls.list()).toEqual([
+    { id: 'b', started: '2026-10-13T03:00:00.000Z', from: 'app', seconds: 3, tasks: 0, preview: 'Is the build green?' },
+    { id: 'a', started: '2026-10-13T01:00:00.000Z', ended: '2026-10-13T01:04:30.000Z', from: 'app', seconds: 270, tasks: 0, preview: 'Is the build green?' },
+  ])
+  expect(calls.get('a')?.turns).toHaveLength(2)
+})
+
+test('ids that are not plain names never reach the disk', () => {
+  using log = scratch()
+  expect(log.calls.get('../.env')).toBeUndefined()
+  expect(log.calls.delete('../.env')).toBe(false)
+})
+
+test('a waiting list request answers as soon as a call changes', async () => {
+  using log = scratch()
+  const { calls } = log
+  const seen = calls.version
+  const changed = calls.changes(seen, 5000)
+  calls.save(record('a', '2026-10-13T01:00:00.000Z'))
+  await changed
+  expect(calls.version).toBeGreaterThan(seen)
+  expect(calls.delete('a')).toBe(true)
+  expect(calls.list()).toEqual([])
+})
+
+test('a list request from before a restart answers right away', async () => {
+  using log = scratch()
+  const started = Date.now()
+  await log.calls.changes(log.calls.version - 1, 5000)
+  expect(Date.now() - started).toBeLessThan(100)
+})
+
+test('how a call ended: the caller, hex, the time limit, or a dropped connection', () => {
+  expect(ending('close_requested', 'close-you-app')).toBe('you')
+  expect(ending('close_requested')).toBe('you')
+  expect(ending('remote_hangup')).toBe('you')
+  expect(ending('close_requested', 'close_hex_1')).toBe('hex')
+  expect(ending('expired')).toBe('expired')
+  expect(ending('content')).toBe('hex')
+  expect(ending('connection_lost')).toBe('dropped')
+  expect(ending('connection closed')).toBe('dropped')
+})
+
+test("a call's cost is its billed audio at five cents a minute, and the list leaves out hex's own words", () => {
+  expect(usage(90, 0.4)).toEqual({ seconds: 90, dollars: 0.08, context: 0.4 })
+  expect(usage(600)).toEqual({ seconds: 600, dollars: 0.5 })
+  const listed = summary(record('a', '2026-10-13T01:00:00.000Z', { moments: [{ at: 1, kind: 'say', text: 'hi' }], summary: 'Checked CI.', waiting: ['Merge the PR'] }))
+  expect(listed).not.toHaveProperty('moments')
+  expect(listed).toMatchObject({ summary: 'Checked CI.', waiting: ['Merge the PR'] })
+})
diff --git a/external_plugins/voice/calls.ts b/external_plugins/voice/calls.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf99b7abd3335c71c446a3b541df58df60665d4e
--- /dev/null
+++ b/external_plugins/voice/calls.ts
@@ -0,0 +1,98 @@
+import { mkdirSync, readdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'fs'
+import { join } from 'path'
+import type { Mark, Moment, Speaker } from './call.ts'
+import { Changes } from './changes.ts'
+
+export type Source = 'app' | 'web' | 'phone-in' | 'phone-out'
+
+export type Ending = 'you' | 'hex' | 'dropped' | 'expired' | 'no-connect' | 'no-answer' | 'busy'
+
+export type CallRecord = {
+  id: string
+  started: string
+  ended?: string
+  end?: Ending
+  reason?: string
+  from: Source
+  voice?: string
+  title?: string
+  claude?: string
+  why?: string
+  summary?: string
+  waiting?: string[]
+  expires?: string
+  usage?: Usage
+  turns: { who: Speaker; at: number; text: string }[]
+  tasks: Moment[]
+  moments?: Mark[]
+}
+
+export type CallSummary = Omit<CallRecord, 'turns' | 'tasks' | 'moments'> & { seconds: number; tasks: number; preview: string }
+
+export type Usage = { seconds: number; dollars: number; context?: number }
+
+export function usage(seconds: number, context?: number): Usage {
+  return { seconds, dollars: Math.round(seconds * 5 / 60) / 100, ...(context === undefined ? {} : { context }) }
+}
+
+const ID = /^[\w-]+$/
+
+export function ending(reason: string, by?: string): Ending {
+  if (by?.startsWith('close_hex')) return 'hex'
+  if (by?.startsWith('close-you') || reason === 'close_requested' || reason === 'remote_hangup') return 'you'
+  if (reason === 'expired') return 'expired'
+  if (reason === 'content') return 'hex'
+  return 'dropped'
+}
+
+export class CallLog extends Changes {
+  constructor(private dir: string) {
+    super()
+    mkdirSync(dir, { recursive: true })
+  }
+
+  save(record: CallRecord) {
+    const file = this.file(record.id)
+    writeFileSync(`${file}.tmp`, JSON.stringify(record))
+    renameSync(`${file}.tmp`, file)
+    this.changed()
+  }
+
+  get(id: string): CallRecord | undefined {
+    if (!ID.test(id)) return
+    try {
+      return JSON.parse(readFileSync(this.file(id), 'utf8'))
+    } catch {}
+  }
+
+  delete(id: string) {
+    if (!this.get(id)) return false
+    rmSync(this.file(id))
+    this.changed()
+    return true
+  }
+
+  list(): CallSummary[] {
+    return readdirSync(this.dir)
+      .flatMap(name => {
+        const record = name.endsWith('.json') && this.get(name.slice(0, -5))
+        return record ? [summary(record)] : []
+      })
+      .sort((a, b) => b.started.localeCompare(a.started))
+  }
+
+  private file(id: string) {
+    return join(this.dir, `${id}.json`)
+  }
+}
+
+export function summary({ turns, tasks, moments, ...call }: CallRecord): CallSummary {
+  const heard = Math.max(0, ...turns.map(turn => turn.at), ...tasks.map(task => task.at))
+  const ms = call.ended ? Date.parse(call.ended) - Date.parse(call.started) : heard
+  return {
+    ...call,
+    seconds: Math.round(ms / 1000),
+    tasks: new Set(tasks.map(task => task.id)).size,
+    preview: turns.find(turn => turn.who === 'you')?.text.slice(0, 160) ?? '',
+  }
+}
diff --git a/external_plugins/voice/changes.ts b/external_plugins/voice/changes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e104c27234643ab5b1f431b40bae2826f7d7ffd5
--- /dev/null
+++ b/external_plugins/voice/changes.ts
@@ -0,0 +1,28 @@
+export class Changes {
+  version = Date.now()
+  private waiting = new Set<() => void>()
+  private listeners = new Set<() => void>()
+
+  changes(after: number, wait: number) {
+    if (after !== this.version) return Promise.resolve()
+    return new Promise<void>(resolve => {
+      const done = () => {
+        clearTimeout(timer)
+        this.waiting.delete(done)
+        resolve()
+      }
+      const timer = setTimeout(done, wait)
+      this.waiting.add(done)
+    })
+  }
+
+  listen(listener: () => void) {
+    this.listeners.add(listener)
+    return () => void this.listeners.delete(listener)
+  }
+
+  changed() {
+    this.version = Math.max(this.version + 1, Date.now())
+    for (const done of [...this.waiting, ...this.listeners]) done()
+  }
+}
diff --git a/external_plugins/voice/door.test.ts b/external_plugins/voice/door.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f0cf9ec9d94255e1e39a8a1ca655affb3574b355
--- /dev/null
+++ b/external_plugins/voice/door.test.ts
@@ -0,0 +1,135 @@
+import { expect, test } from 'bun:test'
+import { mkdtempSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import { door, voicePort } from './door.ts'
+
+function scratch() {
+  const dir = mkdtempSync(join(tmpdir(), 'door-'))
+  const socket = join(dir, 'http.sock')
+  const servers: { stop: (force?: boolean) => unknown }[] = []
+  const plugin = (handler: Parameters<typeof Bun.serve>[0]) => {
+    rmSync(socket, { force: true })
+    const server = Bun.serve({ ...handler, unix: socket } as Parameters<typeof Bun.serve>[0])
+    servers.push(server)
+    return server
+  }
+  return {
+    dir,
+    socket,
+    plugin,
+    servers,
+    [Symbol.dispose]: () => {
+      for (const server of servers) server.stop(true)
+      rmSync(dir, { recursive: true, force: true })
+    },
+  }
+}
+
+const echo = {
+  async fetch(request: Request) {
+    const { pathname, search } = new URL(request.url)
+    return Response.json({ method: request.method, path: pathname + search, body: await request.text(), auth: request.headers.get('authorization'), forwarded: request.headers.get('x-forwarded-for') })
+  },
+}
+
+test('a request goes on to the plugin as it came, and its answer comes back', async () => {
+  using s = scratch()
+  s.plugin(echo)
+  const front = door({ port: 0, socket: s.socket })!
+  s.servers.push(front)
+  const response = await fetch(`http://127.0.0.1:${front.port}/session?x=1`, {
+    method: 'POST',
+    headers: { authorization: 'Bearer t', 'x-forwarded-for': '100.64.0.2' },
+    body: '{"sdp":"v=0"}',
+  })
+  expect(await response.json()).toEqual({ method: 'POST', path: '/session?x=1', body: '{"sdp":"v=0"}', auth: 'Bearer t', forwarded: '100.64.0.2' })
+})
+
+test('a request made while the plugin restarts waits for it, past the socket the old one left behind', async () => {
+  using s = scratch()
+  writeFileSync(s.socket, '')
+  const front = door({ port: 0, socket: s.socket })!
+  s.servers.push(front)
+  const asked = Date.now()
+  const answer = fetch(`http://127.0.0.1:${front.port}/session`, { method: 'POST', body: 'offer' })
+  await Bun.sleep(300)
+  s.plugin(echo)
+  const response = await answer
+  expect(response.status).toBe(200)
+  expect((await response.json()).body).toBe('offer')
+  expect(Date.now() - asked).toBeLessThan(2000)
+})
+
+test("a call that comes while the last call's session renews waits for the new session, and nothing else waits", async () => {
+  using s = scratch()
+  let renewed!: () => void
+  const renewal = new Promise<void>(resolve => (renewed = resolve))
+  s.plugin({ fetch: () => new Response('old') })
+  const front = door({ port: 0, socket: s.socket, renewal: () => renewal })!
+  s.servers.push(front)
+  const call = fetch(`http://127.0.0.1:${front.port}/session`, { method: 'POST', body: 'offer' })
+  expect(await (await fetch(`http://127.0.0.1:${front.port}/calls`)).text()).toBe('old')
+  s.servers[0]!.stop(true)
+  s.plugin({ fetch: () => new Response('new') })
+  renewed()
+  expect(await (await call).text()).toBe('new')
+})
+
+test('a call waits for a renew no longer than the wait, then goes to the session there is', async () => {
+  using s = scratch()
+  s.plugin({ fetch: () => new Response('old') })
+  const front = door({ port: 0, socket: s.socket, wait: 200, renewal: () => new Promise(() => {}) })!
+  s.servers.push(front)
+  expect(await (await fetch(`http://127.0.0.1:${front.port}/session`, { method: 'POST', body: 'offer' })).text()).toBe('old')
+})
+
+test('with no plugin by the time the wait is up, the answer says so', async () => {
+  using s = scratch()
+  const front = door({ port: 0, socket: s.socket, wait: 200 })!
+  s.servers.push(front)
+  const response = await fetch(`http://127.0.0.1:${front.port}/calls`)
+  expect(response.status).toBe(503)
+})
+
+test("a websocket (a phone call's audio) goes through both ways, and closes with the plugin's end", async () => {
+  using s = scratch()
+  s.plugin({
+    fetch: (request, server) => (server.upgrade(request, { data: new URL(request.url).pathname }) ? undefined : new Response('no', { status: 400 })),
+    websocket: { message: (ws, message) => (message === 'bye' ? ws.close() : ws.send(`${ws.data} heard ${message}`)) },
+  } as Parameters<typeof Bun.serve>[0])
+  const front = door({ port: 0, socket: s.socket })!
+  s.servers.push(front)
+  const ws = new WebSocket(`ws://127.0.0.1:${front.port}/twilio/abc`)
+  const heard = new Promise<string>(resolve => (ws.onmessage = ({ data }) => resolve(String(data))))
+  ws.onopen = () => ws.send('hello')
+  expect(await heard).toBe('/twilio/abc heard hello')
+  const closed = new Promise(resolve => (ws.onclose = resolve))
+  ws.send('bye')
+  await closed
+})
+
+test('a port still held by an old plugin is taken once the new plugin comes up', async () => {
+  using s = scratch()
+  const old = Bun.serve({ hostname: '127.0.0.1', port: 0, fetch: () => new Response('old') })
+  const { port } = old
+  expect(door({ port, socket: s.socket })).toBeUndefined()
+  old.stop(true)
+  s.plugin(echo)
+  await Bun.sleep(100)
+  expect((await (await fetch(`http://127.0.0.1:${port}/calls`)).json()).path).toBe('/calls')
+})
+
+test("the door's port is the plugin's: VOICE_PORT from the environment, then from its .env, then 8790", () => {
+  using s = scratch()
+  const env = join(s.dir, '.env')
+  const before = process.env.VOICE_PORT
+  delete process.env.VOICE_PORT
+  expect(voicePort(env)).toBe(8790)
+  writeFileSync(env, 'OPENAI_API_KEY=sk-1\nVOICE_PORT = 8801\n')
+  expect(voicePort(env)).toBe(8801)
+  process.env.VOICE_PORT = '8802'
+  expect(voicePort(env)).toBe(8802)
+  if (before === undefined) delete process.env.VOICE_PORT
+  else process.env.VOICE_PORT = before
+})
diff --git a/external_plugins/voice/door.ts b/external_plugins/voice/door.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c67dbe8c48afc9e2f4231478df7e0c286e43b03
--- /dev/null
+++ b/external_plugins/voice/door.ts
@@ -0,0 +1,98 @@
+import { readFileSync, watch, type FSWatcher } from 'fs'
+import { homedir } from 'os'
+import { basename, dirname, join } from 'path'
+
+type Pipe = { path: string; queue: (string | Buffer)[]; upstream?: WebSocket }
+
+export function voicePort(env = join(homedir(), '.claude', 'channels', 'voice', '.env')) {
+  let text = ''
+  try {
+    text = readFileSync(env, 'utf8')
+  } catch {}
+  return Number(process.env.VOICE_PORT ?? text.match(/^\s*VOICE_PORT\s*=\s*(\d+)/m)?.[1] ?? 8790)
+}
+
+// Twilio gives up on a webhook after 15 seconds, so a phone call waits less for a new session
+// and lands in the old one rather than failing.
+const PHONE_WAIT = 10_000
+
+// In hex the voice plugin restarts with every call's new session, so the hub holds its port:
+// each request goes on to the plugin's socket, and one that comes while the plugin is
+// restarting waits for it to come back instead of failing. A call that comes while the last
+// call's session is winding down to renew waits for the new session (renewal).
+export function door({ port, socket, wait = 30_000, renewal }: { port: number; socket: string; wait?: number; renewal?: () => Promise<void> }) {
+  const dir = dirname(socket)
+  const name = basename(socket)
+
+  function moved(until: number) {
+    let watcher: FSWatcher | undefined
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const settled = new Promise<void>(resolve => {
+      watcher = watch(dir, (_, file) => file === name && resolve())
+      timer = setTimeout(resolve, Math.max(0, until - Date.now()))
+    })
+    return { settled, close: () => (watcher?.close(), clearTimeout(timer)) }
+  }
+
+  function within(done: Promise<void>, until: number) {
+    let timer: ReturnType<typeof setTimeout> | undefined
+    return Promise.race([done, new Promise<void>(resolve => (timer = setTimeout(resolve, Math.max(0, until - Date.now()))))]).finally(() => clearTimeout(timer))
+  }
+
+  async function pass(request: Request) {
+    const { pathname, search } = new URL(request.url)
+    const body = request.method === 'GET' || request.method === 'HEAD' ? undefined : await request.arrayBuffer()
+    const until = Date.now() + wait
+    const calling = request.method === 'POST' && (pathname === '/session' || pathname === '/twilio/incoming')
+    if (calling && renewal) await within(renewal(), pathname === '/session' ? until : Date.now() + PHONE_WAIT)
+    for (;;) {
+      const next = moved(until)
+      try {
+        return await fetch(`http://voice${pathname}${search}`, { unix: socket, method: request.method, headers: request.headers, body, redirect: 'manual', signal: request.signal })
+      } catch (error) {
+        if ((error as { code?: string }).code !== 'FailedToOpenSocket' || Date.now() >= until) return new Response("hex voice isn't answering", { status: 503 })
+        await next.settled
+      } finally {
+        next.close()
+      }
+    }
+  }
+
+  function listen() {
+    try {
+      return Bun.serve<Pipe>({
+        hostname: '127.0.0.1',
+        port,
+        idleTimeout: 120,
+        fetch(request, server) {
+          if (request.headers.get('upgrade')?.toLowerCase() !== 'websocket') return pass(request)
+          const { pathname, search } = new URL(request.url)
+          return server.upgrade(request, { data: { path: pathname + search, queue: [] } }) ? undefined : new Response('upgrade failed', { status: 400 })
+        },
+        websocket: {
+          open(client) {
+            const upstream = (client.data.upstream = new WebSocket(`ws+unix://${socket}:${client.data.path}`))
+            upstream.binaryType = 'nodebuffer'
+            upstream.onopen = () => client.data.queue.splice(0).forEach(message => upstream.send(message))
+            upstream.onmessage = ({ data }) => client.send(data)
+            upstream.onclose = () => client.close()
+          },
+          message(client, message) {
+            const { upstream, queue } = client.data
+            if (upstream?.readyState === WebSocket.OPEN) upstream.send(message)
+            else queue.push(message)
+          },
+          close(client) {
+            client.data.upstream?.close()
+          },
+        },
+      })
+    } catch (error) {
+      if ((error as { code?: string }).code !== 'EADDRINUSE') throw error
+      process.stderr.write(`voice door: port ${port} is taken, so it tries again once the plugin comes up on ${socket}\n`)
+      const watcher = watch(dir, (_, file) => file === name && (watcher.close(), listen()))
+    }
+  }
+
+  return listen()
+}
