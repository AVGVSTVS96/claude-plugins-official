+    font: 600 16px/1 inherit; font-family: inherit; touch-action: manipulation; transition: transform 120ms ease-out; }
+  #phone:active { transform: scale(0.97); }
+</style>
+<header><h1>voice</h1><span id="status">ready</span></header>
+<main id="log"></main>
+<button id="call">Start call</button>
+<button id="phone">Call my phone</button>
+<audio id="speaker" autoplay></audio>
+<script type="module">
+  const button = document.getElementById('call')
+  const status = document.getElementById('status')
+  const log = document.getElementById('log')
+  const speaker = document.getElementById('speaker')
+  let peer, events, microphone, last
+
+  const say = text => (status.textContent = text)
+
+  function caption(who, text) {
+    if (last?.who !== who) {
+      const turn = document.createElement('div')
+      turn.className = `turn ${who}`
+      turn.innerHTML = `<b>${who}</b><span></span>`
+      log.append(turn)
+      last = { who, body: turn.querySelector('span') }
+    }
+    last.body.textContent += text
+    log.scrollTop = log.scrollHeight
+  }
+
+  function hangUp(text) {
+    microphone?.getTracks().forEach(track => track.stop())
+    events?.close()
+    peer?.close()
+    peer = events = microphone = undefined
+    button.disabled = false
+    button.classList.remove('live')
+    button.textContent = 'Start call'
+    say(text)
+  }
+
+  async function call() {
+    button.disabled = true
+    say('connecting…')
+    peer = new RTCPeerConnection()
+    peer.ontrack = ({ track }) => (speaker.srcObject = new MediaStream([track]))
+    microphone = await navigator.mediaDevices.getUserMedia({ audio: true })
+    for (const track of microphone.getAudioTracks()) peer.addTrack(track, microphone)
+    events = peer.createDataChannel('oai-events')
+    events.onmessage = ({ data }) => {
+      const event = JSON.parse(data)
+      if (event.type === 'session.started') {
+        button.disabled = false
+        button.classList.add('live')
+        button.textContent = 'End call'
+        say('live')
+      }
+      if (event.type === 'session.input_transcript.delta') caption('you', event.delta)
+      if (event.type === 'session.output_transcript.delta') caption('voice', event.delta)
+      if (event.type === 'session.closed') hangUp('call ended')
+    }
+    await peer.setLocalDescription(await peer.createOffer())
+    await new Promise(resolve => {
+      if (peer.iceGatheringState === 'complete') return resolve()
+      peer.onicegatheringstatechange = () => peer.iceGatheringState === 'complete' && resolve()
+    })
+    const response = await fetch('session', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ sdp: peer.localDescription.sdp }),
+    })
+    if (!response.ok) throw new Error(await response.text())
+    const { transport } = await response.json()
+    await peer.setRemoteDescription({ type: 'answer', sdp: transport.sdp })
+  }
+
+  const phone = document.getElementById('phone')
+  phone.onclick = async () => {
+    phone.disabled = true
+    const response = await fetch('phone', { method: 'POST' })
+    say(await response.text())
+    phone.disabled = false
+  }
+
+  button.onclick = () => {
+    if (!peer) return call().catch(error => hangUp(error.message))
+    button.disabled = true
+    say('ending…')
+    events.send(JSON.stringify({ type: 'session.close', event_id: 'close-you-web' }))
+  }
+</script>
+</html>
