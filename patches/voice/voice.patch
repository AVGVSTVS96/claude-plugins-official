+++ b/external_plugins/voice/page.html
@@ -0,0 +1,122 @@
+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>voice</title>
+<style>
+  :root { --bg: #fafaf7; --fg: #111; --dim: #8a8a85; --line: #e4e4de; --accent: #ff4d2e; color-scheme: light dark; }
+  @media (prefers-color-scheme: dark) { :root { --bg: #0e0e0d; --fg: #f2f2ee; --dim: #74746f; --line: #262624; } }
+  * { box-sizing: border-box; }
+  body { margin: 0; min-height: 100dvh; display: flex; flex-direction: column; background: var(--bg); color: var(--fg);
+    font: 17px/1.45 ui-sans-serif, system-ui, -apple-system, sans-serif; padding: env(safe-area-inset-top) 16px env(safe-area-inset-bottom); }
+  header { display: flex; align-items: baseline; justify-content: space-between; padding: 20px 0 12px; border-bottom: 1px solid var(--line); }
+  h1 { margin: 0; font-size: 20px; letter-spacing: -0.02em; }
+  #status { color: var(--dim); font-size: 14px; }
+  #log { flex: 1; overflow-y: auto; padding: 16px 0; display: flex; flex-direction: column; gap: 12px; }
+  .turn { max-width: 34em; }
+  .turn b { display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--dim); }
+  .turn.voice b { color: var(--accent); }
+  #call { margin: 12px 0 20px; height: 64px; border: 0; border-radius: 32px; font: 600 18px/1 inherit; font-family: inherit;
+    background: var(--fg); color: var(--bg); transition: transform 120ms ease-out, background 160ms ease-out; touch-action: manipulation; }
+  #call:active { transform: scale(0.97); }
+  #call.live { background: var(--accent); color: #fff; }
+  #call:disabled, #phone:disabled { opacity: 0.5; }
+  #phone { margin: -8px 0 20px; height: 48px; border: 1px solid var(--line); border-radius: 24px; background: none; color: var(--fg);
+    font: 600 16px/1 inherit; font-family: inherit; touch-action: manipulation; transition: transform 120ms ease-out; }
+  #phone:active { transform: scale(0.97); }
+</style>
+<header><h1>voice</h1><span id="status">ready</span></header>
+<main id="log"></main>
+<button id="call">Start call</button>
+<button id="phone">Call my phone</button>
+<audio id="speaker" autoplay></audio>
+<script type="module">
+  const button = document.getElementById('call')
+  const status = document.getElementById('status')
+  const log = document.getElementById('log')
+  const speaker = document.getElementById('speaker')
+  let peer, events, microphone, last
+  const hash = new URLSearchParams(location.hash.slice(1)).get('token')
+  if (hash) {
+    localStorage.setItem('voice-token', hash)
+    history.replaceState(null, '', location.pathname)
+  }
+  const token = '__VOICE_TOKEN__' || localStorage.getItem('voice-token')
+  const auth = token ? { Authorization: `Bearer ${token}` } : {}
+
+  const say = text => (status.textContent = text)
+
+  function caption(who, text) {
+    if (last?.who !== who) {
+      const turn = document.createElement('div')
+      turn.className = `turn ${who}`
+      turn.innerHTML = `<b>${who}</b><span></span>`
+      log.append(turn)
+      last = { who, body: turn.querySelector('span') }
+    }
+    last.body.textContent += text
+    log.scrollTop = log.scrollHeight
+  }
+
+  function hangUp(text) {
+    microphone?.getTracks().forEach(track => track.stop())
+    events?.close()
+    peer?.close()
+    peer = events = microphone = undefined
+    button.disabled = false
+    button.classList.remove('live')
+    button.textContent = 'Start call'
+    say(text)
+  }
+
+  async function call() {
+    button.disabled = true
+    say('connecting…')
+    peer = new RTCPeerConnection()
+    peer.ontrack = ({ track }) => (speaker.srcObject = new MediaStream([track]))
+    microphone = await navigator.mediaDevices.getUserMedia({ audio: true })
+    for (const track of microphone.getAudioTracks()) peer.addTrack(track, microphone)
+    events = peer.createDataChannel('oai-events')
+    events.onmessage = ({ data }) => {
+      const event = JSON.parse(data)
+      if (event.type === 'session.started') {
+        button.disabled = false
+        button.classList.add('live')
+        button.textContent = 'End call'
+        say('live')
+      }
+      if (event.type === 'session.input_transcript.delta') caption('you', event.delta)
+      if (event.type === 'session.output_transcript.delta') caption('voice', event.delta)
+      if (event.type === 'session.closed') hangUp('call ended')
+    }
+    await peer.setLocalDescription(await peer.createOffer())
+    await new Promise(resolve => {
+      if (peer.iceGatheringState === 'complete') return resolve()
+      peer.onicegatheringstatechange = () => peer.iceGatheringState === 'complete' && resolve()
+    })
+    const response = await fetch('session', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', ...auth },
+      body: JSON.stringify({ sdp: peer.localDescription.sdp }),
+    })
+    if (!response.ok) throw new Error(await response.text())
+    const { transport } = await response.json()
+    await peer.setRemoteDescription({ type: 'answer', sdp: transport.sdp })
+  }
+
+  const phone = document.getElementById('phone')
+  phone.onclick = async () => {
+    phone.disabled = true
+    const response = await fetch('phone', { method: 'POST', headers: auth })
+    say(await response.text())
+    phone.disabled = false
+  }
+
+  button.onclick = () => {
+    if (!peer) return call().catch(error => hangUp(error.message))
+    button.disabled = true
+    say('ending…')
+    events.send(JSON.stringify({ type: 'session.close', event_id: 'close-you-web' }))
+  }
+</script>
+</html>
