+  let up = false
+  let gone = false
+  const openai: WebSocket = passThrough({
+    name: from,
+    from,
+    greeting,
+    format: { type: 'audio/pcm', rate: 24000 },
+    play: line.play,
+    started: () => (up = true),
+    refused: reason => {
+      if (!gone) failed({ from, end: 'no-connect', reason })
+      gone = true
+      openai.close()
+      line.end()
+    },
+    closed: line.end,
+  })
