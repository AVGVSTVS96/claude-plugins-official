@@ -0,0 +1,21 @@
+import { readFileSync } from 'fs'
+import { homedir } from 'os'
+import { join } from 'path'
+
+export const STATE_DIR = join(homedir(), '.claude', 'channels', 'voice')
+
+// The plugin's own settings, its OpenAI and Twilio keys among them, under what the service's
+// environment sets. They stay here: the hub service's sessions inherit its environment.
+function settings(): Record<string, string | undefined> {
+  const file: Record<string, string> = {}
+  try {
+    for (const line of readFileSync(join(STATE_DIR, '.env'), 'utf8').split('\n')) {
+      const match = line.match(/^\s*([A-Z_]+)\s*=\s*(.*?)\s*$/)
+      if (match) file[match[1]!] = match[2]!
+    }
+  } catch {}
+  return { ...file, ...process.env }
+}
+
+export const env = settings()
+export const PORT = Number(env.VOICE_PORT ?? 8790)
diff --git a/external_plugins/voice/line.test.ts b/external_plugins/voice/line.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f7b54c8e527985e41b57badfef0490c7abfb7d7f
--- /dev/null
+++ b/external_plugins/voice/line.test.ts
@@ -0,0 +1,148 @@
+import { expect, test } from 'bun:test'
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+// A call on a line another client holds (a Discord voice channel), end to end against a stand-in
+// for OpenAI's live API: the engine runs on its own with a hub that takes everything, and the test
+// plays the client holding the line, through lines on the engine's stdin and stdout.
+// hold: OpenAI never starts the session; refuse: it answers the start with an error.
+async function lineCall({ hold = false, refuse = false } = {}) {
+  const home = mkdtempSync(join(tmpdir(), 'line-'))
+  const state = join(home, '.claude', 'channels', 'voice')
+  mkdirSync(state, { recursive: true })
+  const heard: string[] = []
+  const started: any[] = []
+  let voice: Bun.ServerWebSocket<unknown> | undefined
+  const openai = Bun.serve({
+    port: 0,
+    fetch: (request, server) => (server.upgrade(request) ? undefined : new Response('no', { status: 400 })),
+    websocket: {
+      open: socket => {
+        voice = socket
+      },
+      message(socket, raw) {
+        const event = JSON.parse(String(raw))
+        if (event.type === 'session.start') {
+          started.push(event.session)
+          if (refuse) socket.send(JSON.stringify({ type: 'error', error: { message: 'no capacity' } }))
+          else if (!hold) socket.send(JSON.stringify({ type: 'session.started', session: { id: 'sess_discord', expires_at: Date.now() / 1000 + 3600 } }))
+        }
+        if (event.type === 'session.input_audio.append') heard.push(event.audio)
+        if (event.type === 'session.thinking.append') socket.send(JSON.stringify({ type: 'session.thinking.appended', client_event_id: event.event_id }))
+        if (event.type === 'session.close') socket.send(JSON.stringify({ type: 'session.closed', reason: 'close_requested', client_event_id: event.event_id }))
+      },
+    },
+  })
+  const port = 20000 + Math.floor(Math.random() * 20000)
+  writeFileSync(join(state, '.env'), [`OPENAI_API_KEY=test`, `OPENAI_BASE_URL=http://127.0.0.1:${openai.port}/v1`, `VOICE_PORT=${port}`].join('\n'))
+  const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => !/^(VOICE|TWILIO|OPENAI|CALLER|HEX)_/.test(key)))
+  const hex = join(home, 'hex', 'state')
+  mkdirSync(join(hex, 'discord'), { recursive: true })
+  const engine = `import { serve, take, tool } from ${JSON.stringify(join(import.meta.dir, 'server.ts'))}
+import { clients } from ${JSON.stringify(join(import.meta.dir, '..', '..', 'hub', 'hub.ts'))}
+const step = (step, more = {}) => console.log(JSON.stringify({ step, ...more }))
+clients.set('discord', {
+  hub: { register: () => {}, deliver: (thread, name, message) => step('delivered', { thread, name, message }) },
+  place: async (name, where, about) => (step('placed', { name, where, about }), { thread: '9001', link: 'https://discord.com/channels/1/9001' }),
+})
+serve({
+  deliver: (content, meta) => step('deliver', { content, meta }),
+  keep: () => step('keep'),
+  renew: () => step('renew'),
+  renewal: async () => {},
+  session: () => 'brain',
+}, ${JSON.stringify(hex)})
+const held = take('discord', 'They joined you in a Discord voice channel.', { play: audio => step('play', { audio }), end: () => step('end') })
+for await (const line of console) {
+  const [verb, audio] = line.split(' ')
+  if (verb === 'hear') held.hear(audio)
+  if (verb === 'hangup') held.hangUp()
+  if (verb === 'send') tool('send', JSON.parse(line.slice(5))).then(text => step('sent', { text }), error => step('sent', { error: error.message }))
+}`
+  const plugin = Bun.spawn(['bun', '-e', engine], { env: { ...env, HOME: home }, stdin: 'pipe', stdout: 'pipe', stderr: 'ignore' })
+  const steps: any[] = []
+  void (async () => {
+    let buffer = ''
+    for await (const chunk of plugin.stdout) {
+      buffer += new TextDecoder().decode(chunk)
+      const lines = buffer.split('\n')
+      buffer = lines.pop()!
+      steps.push(...lines.map(line => JSON.parse(line)))
+    }
+  })()
+  return {
+    base: `http://127.0.0.1:${port}`,
+    heard,
+    started,
+    steps,
+    tell: (line: string) => (plugin.stdin.write(`${line}\n`), plugin.stdin.flush()),
+    speak: (audio: string) => voice!.send(JSON.stringify({ type: 'session.output_audio.delta', delta: audio })),
+    [Symbol.asyncDispose]: async () => {
+      plugin.kill()
+      await plugin.exited
+      openai.stop(true)
+      rmSync(home, { recursive: true, force: true })
+    },
+  }
+}
+
+async function until<T>(check: () => T | undefined, timeout = 5000): Promise<T> {
+  for (const end = Date.now() + timeout; Date.now() < end; await Bun.sleep(20)) {
+    const value = check()
+    if (value) return value
+  }
+  throw new Error('timed out')
+}
+
+test("a call on another client's line is held like a phone call: PCM both ways, the voice session told, a record of its own, and the line ended when the caller hangs up", async () => {
+  await using call = await lineCall()
+  const session = await until(() => call.started[0])
+  expect(session.audio.format).toEqual({ type: 'audio/pcm', rate: 24000 })
+  expect(session.input[0].content[0].text).toBe('They joined you in a Discord voice channel.')
+
+  await until(() => call.steps.find(step => step.step === 'keep'))
+  expect(call.steps.find(step => step.step === 'deliver').content).toStartWith('A call started.')
+  call.tell('hear AAAA')
+  await until(() => call.heard.length)
+  expect(call.heard).toEqual(['AAAA'])
+  call.speak('BBBB')
+  expect(await until(() => call.steps.find(step => step.step === 'play'))).toEqual({ step: 'play', audio: 'BBBB' })
+  expect((await fetch(`${call.base}/calls`).then(r => r.json())).live).toBe('sess_discord')
+
+  call.tell(`send ${JSON.stringify({ thread: 'Anchors', about: 'the anchors', text: 'look into the anchors', app: 'discord' })}`)
+  expect(await until(() => call.steps.find(step => step.step === 'sent'))).toEqual({ step: 'sent', text: 'opened Anchors in discord, on the board as the-anchors' })
+  expect(call.steps.find(step => step.step === 'placed')).toEqual({ step: 'placed', name: 'Anchors', about: 'From a call: the anchors' })
+  expect(call.steps.find(step => step.step === 'delivered')).toEqual({
+    step: 'delivered',
+    thread: '9001',
+    name: 'Anchors',
+    message: { content: 'look into the anchors', meta: { user: 'hex voice', voice_task: 'sess_discord:the-anchors' } },
+  })
+
+  call.tell('hangup')
+  await until(() => call.steps.find(step => step.step === 'end'))
+  await until(() => call.steps.find(step => step.step === 'renew'))
+  const record = await fetch(`${call.base}/calls/sess_discord`).then(r => r.json())
+  expect(record).toMatchObject({ id: 'sess_discord', from: 'discord', end: 'you', claude: 'brain' })
+}, 20_000)
+
+test('a line hung up on before its session starts never becomes a call, and one OpenAI refuses ends its line and is reported once', async () => {
+  {
+    await using call = await lineCall({ hold: true })
+    await until(() => call.started[0])
+    call.tell('hangup')
+    await until(() => call.steps.find(step => step.step === 'end'))
+    await Bun.sleep(200)
+    expect((await fetch(`${call.base}/calls`).then(r => r.json())).calls).toEqual([])
+    expect(call.steps.some(step => step.step === 'deliver' || step.step === 'keep')).toBe(false)
+  }
+  await using call = await lineCall({ refuse: true })
+  await until(() => call.steps.find(step => step.step === 'end'))
+  await Bun.sleep(200)
+  const told = call.steps.filter(step => step.step === 'deliver')
+  expect(told).toHaveLength(1)
+  expect(told[0].content).toBe("A call from a Discord voice channel didn't happen: it never connected (OpenAI refused the discord session: no capacity).")
+  const [record] = (await fetch(`${call.base}/calls`).then(r => r.json())).calls
+  expect(record).toMatchObject({ from: 'discord', end: 'no-connect' })
+}, 20_000)
diff --git a/external_plugins/voice/links.ts b/external_plugins/voice/links.ts
new file mode 100644
index 0000000000000000000000000000000000000000..252bd38ba2b65227261b36ce5de7e9bf44f593b9
--- /dev/null
+++ b/external_plugins/voice/links.ts
@@ -0,0 +1,123 @@
+import { Database } from 'bun:sqlite'
+import { existsSync, readFileSync, watch } from 'fs'
+import { homedir } from 'os'
+import { join } from 'path'
+
+const T3_HOME = join(homedir(), '.t3', 'userdata')
+const DATABASE = 'statev2.sqlite'
+const REFRESH = 500
+
+// Where a hex thread lives in its own app. Each bot leaves what its links need in its state folder
+// (Discord's server, Telegram's bot name, the channel of every Buzz thread), and T3 Code's own database,
+// read only, says which T3 thread a hex thread is and what it's called there. An app that can't say gives no link.
+// T3_APP_SCHEME is the T3 Code app's URL scheme: t3code, t3code-preview or t3code-dev.
+export class Links {
+  private guild?: string
+  private bot?: string
+  private channels: Record<string, string> = {}
+  private threads = new Map<string, { thread: string; title: string }>()
+  private environment?: string
+  private db?: Database
+  private watcher?: ReturnType<typeof watch>
+  private pending?: ReturnType<typeof setTimeout>
+
+  constructor(
+    private state: string,
+    private changed: () => void,
+    private t3 = T3_HOME,
+    private scheme = process.env.T3_APP_SCHEME || 't3code',
+  ) {
+    const database = join(t3, DATABASE)
+    if (!existsSync(database)) return
+    this.environment = word(readFile(join(t3, 'environment-id'))?.trim())
+    this.db = new Database(database, { readonly: true })
+    this.watcher = watch(t3, (_, file) => file?.startsWith(DATABASE) && this.schedule())
+    this.read()
+  }
+
+  close() {
+    clearTimeout(this.pending)
+    this.watcher?.close()
+    this.db?.close()
+  }
+
+  // The small files the bots keep; read again whenever the threads are.
+  load() {
+    this.guild = word(readJson(join(this.state, 'discord', 'guild.json'))?.id)
+    this.bot = word(readJson(join(this.state, 'telegram', 'bot.json'))?.username)
+    this.channels = readJson(join(this.state, 'buzz', 'channels.json')) ?? {}
+  }
+
+  of(app: string, id: string): string | undefined {
+    switch (app) {
+      case 'telegram': {
+        if (!id.includes(':') && !id.startsWith('-')) return this.bot && `https://t.me/${this.bot}`
+        if (!id.startsWith('-100')) return
+        const [chat, topic = '1'] = id.slice(4).split(':')
+        return `https://t.me/c/${chat}/${topic}`
+      }
+      case 'discord':
+        return this.guild && `https://discord.com/channels/${this.guild}/${id}`
+      case 'buzz': {
+        if (id.includes('-')) return `buzz://channel/${id}`
+        const channel = word(this.channels[id])
+        return channel && `buzz://message?channel=${channel}&id=${id}`
+      }
+      case 't3': {
+        const thread = this.threads.get(id)?.thread
+        return thread && this.environment && `${this.scheme}://threads/${this.environment}/${encodeURIComponent(thread)}`
+      }
+    }
+  }
+
+  // What the thread is called in its own app, where hex knows it by another name: T3 Code's title.
+  title(app: string, id: string): string | undefined {
+    return app === 't3' ? word(this.threads.get(id)?.title) : undefined
+  }
+
+  private schedule() {
+    if (this.pending) return
+    this.pending = setTimeout(() => {
+      this.pending = undefined
+      if (this.read()) this.changed()
+    }, REFRESH)
+  }
+
+  // A hex thread's key is the session id the T3 Code ACP agent holds as its native thread.
+  private read() {
+    try {
+      const rows = this.db!
+        .query<{ key: string; thread: string; title: string }, []>(
+          `select json_extract(p.payload_json, '$.nativeThreadRef.nativeId') key, json_extract(p.payload_json, '$.appThreadId') thread, t.title
+           from orchestration_v2_projection_provider_threads p
+           join orchestration_v2_projection_threads t on t.thread_id = json_extract(p.payload_json, '$.appThreadId')
+           where p.driver = 'acpRegistry' and t.deleted_at is null
+           order by p.updated_at`,
+        )
+        .all()
+      const threads = new Map(rows.map(({ key, thread, title }) => [key, { thread, title }]))
+      if (JSON.stringify([...threads]) === JSON.stringify([...this.threads])) return false
+      this.threads = threads
+      return true
+    } catch (error) {
+      process.stderr.write(`voice: links: couldn't read T3 Code's threads: ${error}\n`)
+      return false
+    }
+  }
+}
+
+function word(value: unknown) {
+  return typeof value === 'string' && value ? value : undefined
+}
+
+function readFile(path: string) {
+  try {
+    return readFileSync(path, 'utf8')
+  } catch {}
+}
+
+function readJson(path: string) {
+  try {
+    return JSON.parse(readFile(path) ?? '')
+  } catch {}
+}
