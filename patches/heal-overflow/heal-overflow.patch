+++ b/external_plugins/voice/asks.test.ts
@@ -0,0 +1,205 @@
+import { afterEach, beforeEach, expect, test } from 'bun:test'
+import { Database } from 'bun:sqlite'
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from 'fs'
+import { createServer, type Server } from 'net'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import { Asks, fromLedger } from './asks.ts'
+import { vet } from './check.ts'
+import { T3 } from './t3.ts'
+
+const GROUP = '-1001234'
+const DESK = `${GROUP}:5`
+let state: string
+let asks: Asks
+let hub: Server
+let lines: any[]
+let checks: string[]
+
+function ledger(asks: object[], pins = {}) {
+  writeFileSync(join(state, 'telegram', 'ledger.json'), JSON.stringify({ asks, pins }))
+}
+
+function asked(message: number, text: string, options: string[], fields = {}) {
+  return { thread: DESK, message, text, options, at: `2026-10-13T1${message % 10}:00:00.000Z`, ...fields }
+}
+
+async function until<T>(check: () => T | undefined, timeout = 3000): Promise<T> {
+  for (const end = Date.now() + timeout; Date.now() < end; await Bun.sleep(20)) {
+    const value = check()
+    if (value) return value
+  }
+  throw new Error('timed out')
+}
+
+beforeEach(async () => {
+  state = mkdtempSync(join(tmpdir(), 'asks-'))
+  mkdirSync(join(state, 'telegram'))
+  mkdirSync(join(state, 'voice'))
+  writeFileSync(join(state, 'telegram', 'threads.json'), JSON.stringify({ [GROUP]: { name: 'hex' }, [DESK]: { name: 'desk' } }))
+  lines = []
+  checks = []
+  hub = createServer(socket => {
+    socket.setEncoding('utf8')
+    socket.on('data', (chunk: string) => lines.push(...chunk.trim().split('\n').map(line => JSON.parse(line))))
+  })
+  await new Promise<void>(resolve => hub.listen(join(state, 'telegram', 'hub.sock'), resolve))
+})
+
+afterEach(() => {
+  asks?.close()
+  hub.close()
+})
+
+test('a question asked with buttons reads as its first line, its context and the pick its thread marked', () => {
+  const ask = fromLedger('telegram', asked(1, '**Music for the Saves video?**\n\nThree new takes, no cost.\n```\nA  Deep\n```', ['Deep (my pick)', 'French touch', 'Minimal']))
+  expect(ask).toMatchObject({
+    id: `telegram:${DESK}:1`,
+    kind: 'pick',
+    task: `telegram:${DESK}`,
+    question: 'Music for the Saves video?',
+    context: 'Three new takes, no cost.',
+    options: [{ label: 'Deep', value: 'Deep (my pick)', pick: true }, { label: 'French touch', value: 'French touch' }, { label: 'Minimal', value: 'Minimal' }],
+  })
+})
+
+test('open questions come newest first with a link to each, answered and settled ones drop out', () => {
+  ledger([asked(1, 'Ship it?', ['Yes', 'No']), asked(2, 'Rename it?', ['Yes', 'No'], { answer: { label: 'No', at: '', via: 'telegram' } }), asked(3, 'Which color?', ['Mint', 'Coral'])])
+  asks = new Asks(state, { t3Database: '/nonexistent', check: why => checks.push(why) })
+  expect(asks.view.asks.map(ask => [ask.question, ask.app, ask.topic, ask.link])).toEqual([
+    ['Which color?', 'telegram', 'desk', 'https://t.me/c/1234/5/3'],
+    ['Ship it?', 'telegram', 'desk', 'https://t.me/c/1234/5/1'],
+  ])
+})
+
+test('the check’s version of a question stands in for every place that asked it, and newer questions lead', async () => {
+  ledger([asked(1, 'Twilio?', ['Upgrade', 'Not yet']), asked(2, 'Upgrade Twilio now?', ['Go', 'Wait']), asked(9, 'Brand new?', ['Yes', 'No'])])
+  writeFileSync(
+    join(state, 'voice', 'check.json'),
+    JSON.stringify({
+      at: '2026-10-13T15:00:00.000Z',
+      why: 'a pinned post changed',
+      read: {},
+      fixed: [],
+      flagged: [],
+      stuck: [],
+      asks: [
+        {
+          id: 'check:twilio',
+          kind: 'do',
+          task: `telegram:${DESK}`,
+          at: '2026-10-11T00:00:00.000Z',
+          question: 'Upgrade Twilio from trial',
+          options: [{ label: 'Upgrade', value: 'Upgrade', pick: true }, { label: 'Use the app', value: 'Not yet' }],
+          tag: 'unblocks 3',
+          refs: [{ app: 'telegram', thread: DESK, message: 1 }, { app: 'telegram', thread: DESK, message: 2 }],
+        },
+        { id: 'check:read', kind: 'look', task: `telegram:${DESK}`, at: '2026-10-13T00:00:00.000Z', question: 'Read the launch review', options: [{ label: 'Open' }] },
+      ],
+    }),
+  )
+  asks = new Asks(state, { t3Database: '/nonexistent', check: why => checks.push(why) })
+  expect(asks.view.asks.map(ask => ask.id)).toEqual([`telegram:${DESK}:9`, 'check:twilio', 'check:read'])
+  expect(asks.view.asks.map(ask => ask.app)).toEqual(['telegram', 'telegram', 'telegram'])
+  expect(asks.view.check).toEqual({ at: '2026-10-13T15:00:00.000Z', why: 'a pinned post changed', fixed: 0, flagged: 0 })
+
+  await asks.answer('check:twilio', 'Use the app', 'app')
+  await until(() => lines.length === 2)
+  expect(lines).toEqual([
+    { type: 'answer', thread: DESK, message: 1, label: 'Not yet', via: 'app' },
+    { type: 'settle', thread: DESK, message: 2, note: '✓ Answered in the app: Use the app' },
+  ])
+
+  await asks.answer('check:read', 'Open', 'app')
+  expect(await until(() => lines.find(line => line.type === 'inbound'))).toEqual({ type: 'inbound', thread: DESK, content: '(answered in the app) Read the launch review: Open', meta: { user: 'hex app' } })
+  await until(() => !asks.find('check:read'))
+  await asks.undo('check:read', 'app')
+  await until(() => asks.find('check:read'))
+})
+
+test('an answer that lands in the ledger takes the question off the list, and undo asks for its buttons back', async () => {
+  ledger([asked(1, 'Ship it?', ['Yes', 'No'])])
+  asks = new Asks(state, { t3Database: '/nonexistent', check: why => checks.push(why) })
+  const version = asks.version
+  await asks.answer(`telegram:${DESK}:1`, 'Yes', 'app')
+  expect(await until(() => lines[0])).toEqual({ type: 'answer', thread: DESK, message: 1, label: 'Yes', via: 'app' })
+  ledger([asked(1, 'Ship it?', ['Yes', 'No'], { answer: { label: 'Yes', at: '', via: 'app' } })])
+  await asks.changes(version, 2000)
+  expect(asks.view.asks).toEqual([])
+  await asks.undo(`telegram:${DESK}:1`, 'app')
+  expect(await until(() => lines[1])).toEqual({ type: 'reopen', thread: DESK, message: 1, via: 'app' })
+})
+
+test('a stuck item with a request goes to General, one without is put away', async () => {
+  writeFileSync(
+    join(state, 'voice', 'check.json'),
+    JSON.stringify({
+      at: '2026-10-13T15:00:00.000Z', why: 'a call ended', read: {}, asks: [], fixed: [], flagged: [],
+      stuck: [
+        { id: 'disk', title: 'cloud’s disk fails every read', why: 'Since 1:10am.', action: 'Restore', mark: 'failed', at: '', request: 'Restore cloud from checkpoint v7.' },
+        { id: 'runs', title: '5 T3 runs ended in an error', why: 'Their work landed.', action: 'Settle', mark: 'failed', at: '' },
+      ],
+    }),
+  )
+  asks = new Asks(state, { t3Database: '/nonexistent', check: why => checks.push(why) })
+  await asks.act('disk')
+  expect(await until(() => lines[0])).toEqual({ type: 'inbound', thread: GROUP, content: 'Restore cloud from checkpoint v7.', meta: { user: 'hex app' } })
+  await asks.act('runs')
+  await until(() => asks.view.stuck.length === 1)
+  expect(asks.view.stuck[0]).toMatchObject({ id: 'disk', app: 'hex', sent: expect.any(String) })
+  expect(JSON.parse(readFileSync(join(state, 'voice', 'marks.json'), 'utf8')).dismissed.runs).toBeString()
+})
+
+test('T3 Code’s records give what waits on a limit, what never started, what failed unseen, and what finished since you looked', () => {
+  const path = join(state, 't3.sqlite')
+  const db = new Database(path)
+  db.run(`create table orchestration_v2_projection_threads (thread_id text, project_id text, title text, archived_at text, deleted_at text, payload_json text)`)
+  db.run(`create table projection_projects (project_id text, title text)`)
+  db.run(`create table orchestration_v2_projection_runs (thread_id text, ordinal int, status text, requested_at text, completed_at text)`)
+  db.run(`create table orchestration_v2_projection_messages (thread_id text, role text, created_at text, payload_json text)`)
+  db.run(`insert into projection_projects values ('p', 'hex')`)
+  const thread = (id: string, payload: object) => db.run(`insert into orchestration_v2_projection_threads values (?, 'p', ?, null, null, ?)`, [id, `${id} thread`, JSON.stringify(payload)])
+  thread('parked', { limitRecovery: { resetAt: '2026-10-18T19:00:00.000Z' } })
+  thread('queued', {})
+  thread('broken', { lastVisitedAt: '2026-10-13T08:00:00.000Z' })
+  thread('finished', { createdBy: 'user', lastVisitedAt: '2026-10-13T08:00:00.000Z' })
+  thread('seen', { createdBy: 'user', lastVisitedAt: '2026-10-13T12:00:00.000Z' })
+  const run = (id: string, ordinal: number, status: string, completed: string | null) => db.run(`insert into orchestration_v2_projection_runs values (?, ?, ?, '2026-10-09T23:00:00.000Z', ?)`, [id, ordinal, status, completed])
+  run('parked', 1, 'failed', '2026-10-13T10:00:00.000Z')
+  run('queued', 1, 'queued', null)
+  run('broken', 1, 'failed', '2026-10-13T10:00:00.000Z')
+  run('finished', 1, 'completed', '2026-10-13T10:00:00.000Z')
+  run('seen', 1, 'completed', '2026-10-13T10:00:00.000Z')
+  db.run(`insert into orchestration_v2_projection_messages values ('finished', 'assistant', '2026-10-13T10:00:00.000Z', ?)`, [JSON.stringify({ text: '## Done\n\n**Shipped** the memory fix.' })])
+  db.close()
+
+  const t3 = new T3(() => {}, path)
+  const { stuck, fresh } = t3.query(Date.parse('2026-10-13T20:00:00.000Z'))
+  t3.close()
+  expect(stuck.map(item => [item.title, item.action, item.mark])).toEqual([
+    ['1 T3 thread waits for Oct 18', 'Switch plan', 'paused'],
+    ['queued thread: queued since Oct 9', 'Resume', 'paused'],
+    ['broken thread ended in an error', 'Look', 'failed'],
+  ])
+  expect(stuck.every(item => item.request)).toBe(true)
+  expect(fresh).toEqual([{ id: expect.stringMatching(/^t3-done-/), app: 't3', topic: 'hex', title: 'finished thread', where: 'T3 · hex', line: 'Done', at: '2026-10-13T10:00:00.000Z' }])
+  expect(stuck.every(item => item.app === 't3')).toBe(true)
+})
+
+test('a check’s verdict is held to the ledger: real open refs and buttons only, and nothing both settled and listed', () => {
+  const asks = { telegram: [asked(1, 'Twilio?', ['Upgrade', 'Not yet']), asked(2, 'Old?', ['Yes', 'No'], { settled: { note: 'x', at: '' } }), asked(3, 'Music?', ['A', 'B'])] }
+  const ref = (message: number) => ({ app: 'telegram', thread: DESK, message })
+  const verdict = vet(
+    {
+      asks: [{ id: 'twilio', kind: 'do', task: `telegram:${DESK}`, at: '', question: 'Upgrade Twilio', options: [{ label: 'Upgrade', value: 'Upgrade' }, { label: 'Later', value: 'Wait' }], refs: [ref(1), ref(2), ref(9)] }],
+      settle: [{ ...ref(1), note: 'Settled' }, { ...ref(2), note: 'Settled' }, { ...ref(3), note: 'Settled: Tech Live, picked on a call with a very long note' }],
+      fixed: [],
+      flagged: [],
+      stuck: [{ id: 'disk', title: 'disk', why: '', action: 'Look', mark: 'failed', at: '' }],
+    },
+    asks,
+  )
+  expect(verdict.asks[0]).toMatchObject({ id: 'check:twilio', refs: [ref(1)], options: [{ label: 'Upgrade', value: 'Upgrade' }, { label: 'Later' }] })
+  expect(verdict.settle).toEqual([{ ...ref(3), note: 'Settled: Tech Live, picked on a call with a very long note'.slice(0, 60) }])
+  expect(verdict.stuck[0]!.id).toBe('check-disk')
+})
diff --git a/external_plugins/voice/asks.ts b/external_plugins/voice/asks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..83d77090a6e9f64338439e4df0de924e5f02cbc8
--- /dev/null
+++ b/external_plugins/voice/asks.ts
@@ -0,0 +1,350 @@
+import { readdirSync, readFileSync, renameSync, watch, writeFileSync } from 'fs'
+import { join } from 'path'
+import type { Ask as Asked } from '../../hub/ledger.ts'
+import { Changes } from './changes.ts'
+import { Check } from './check.ts'
+import { relay } from './relay.ts'
+import { T3, type Fresh, type Stuck } from './t3.ts'
+
+export type Kind = 'pick' | 'yesno' | 'do' | 'look'
+// value: the button's own label, when the option stands for one; url: an option that opens a page.
+export type Option = { label: string; value?: string; pick?: boolean; url?: string }
+export type Answer = { label: string; at: string; via: string }
+export type Ref = { app: string; thread: string; message: number }
+export type Ask = {
+  id: string
+  kind: Kind
+  task: string
+  app: string
+  topic: string
+  at: string
+  question: string
+  context?: string
+  options: Option[]
+  tag?: string
+  places?: string[]
+  link?: string
+}
+// hex's check rewrites the raw questions into these: one per decision, however many places asked
+// it (refs), in the order that unblocks the most, with its pick and what it costs.
+export type Curated = Omit<Ask, 'app' | 'topic' | 'link'> & { refs?: Ref[] }
+export type Note = { title: string; text: string; did?: string }
+export type CheckResult = {
+  at: string
+  why: string
+  read: Record<string, number>
+  asks: Curated[]
+  fixed: Note[]
+  flagged: Note[]
+  stuck: Omit<Stuck, 'app'>[]
+  inputs?: string
+}
+export type View = {
+  version: number
+  asks: Ask[]
+  stuck: (Stuck & { sent?: string })[]
+  fresh: (Fresh & { read: boolean })[]
+  check: { at: string; why: string; fixed: number; flagged: number } | null
+}
+type Marks = { answers: Record<string, Answer>; sent: Record<string, string>; dismissed: Record<string, string>; read: Record<string, string> }
+
+const KEEP = 14 * 24 * 60 * 60_000
+const WHERE: Record<string, string> = { app: 'in the app', call: 'on a call' }
+const PICK = /\s*[(\[]?\s*(?:←\s*)?(?:(?:my|hex[’']s) pick)\s*[)\]]?/i
+
+// Everything waiting on the owner, in one list: each question a hex thread asked with buttons or a
+// poll and nobody has answered (from each app's ledger), as hex's check last rewrote them; what's
+// stuck and what finished since he looked (T3 Code's own records, and what the check found). An
+// answer goes back the way a tap in the chat app would, through that app's hub.
+export class Asks extends Changes {
+  view: Omit<View, 'version'> = { asks: [], stuck: [], fresh: [], check: null }
+  counts = new Changes()
+  private ledgers = new Map<string, Asked[]>()
+  private names = new Map<string, string>()
+  private pins = new Map<string, string>()
+  private result?: CheckResult
+  private marks: Marks
+  private pending?: ReturnType<typeof setTimeout>
+  private stops: (() => void)[] = []
+  private t3: T3
+  private check: (why: string) => void
+  private seen?: { pins: string; t3: string }
+
+  constructor(
+    private state: string,
+    { t3Database, check = why => new Check(state).start(why) }: { t3Database?: string; check?: (why: string) => void } = {},
+  ) {
+    super()
+    this.check = check
+    this.marks = readMarks(join(state, 'voice', 'marks.json'))
+    this.t3 = new T3(() => this.schedule(), t3Database)
+    for (const app of apps(state)) this.stops.push(watchDir(join(state, app), file => (file === 'ledger.json' || file === 'threads.json') && this.schedule()))
+    this.stops.push(watchDir(join(state, 'voice'), file => file === 'check.json' && this.schedule()))
+    this.build()
+  }
+
+  get lastCheck() {
+    return this.result
+  }
+
+  // Tasks opened with questions newer than the last check, or a call ended: hex checks again.
+  opened() {
+    const checked = this.result?.at ?? ''
+    if ([...this.ledgers.values()].some(asks => asks.some(ask => !ask.answer && !ask.settled && ask.at > checked))) this.check('you opened Tasks')
+  }
+
+  called() {
+    this.check('a call ended')
+  }
+
+  close() {
+    clearTimeout(this.pending)
+    this.t3.close()
+    for (const stop of this.stops) stop()
+  }
+
+  find(id: string) {
+    return this.view.asks.find(ask => ask.id === id)
+  }
+
+  // The thread's own questions and its pinned status post, for its page.
+  of(task: string) {
+    return { asks: this.view.asks.filter(ask => ask.task === task), ...(this.pins.has(task) && { pin: this.pins.get(task) }) }
+  }
+
+  async answer(id: string, label: string, via: string) {
+    const ask = this.find(id)
+    if (!ask) throw new Error('that question is already answered or settled')
+    const option = ask.options.find(option => option.label === label)
+    const refs = this.refs(id).filter(ref => this.open(ref))
+    const where = WHERE[via] ?? via
+    if (!refs.length) {
+      this.marks.answers[id] = { label, at: now(), via }
+      this.saveMarks()
+      return this.tell(ask.task, `(answered ${where}) ${ask.question}: ${label}`, via)
+    }
+    const [first, ...rest] = refs
+    const value = option?.value ?? label
+    if (this.asked(first!)!.options.includes(value)) await relay(this.state, first!.app, { type: 'answer', thread: first!.thread, message: first!.message, label: value, via })
+    else {
+      await this.tell(`${first!.app}:${first!.thread}`, `(answered ${where}) ${ask.question}: ${label}`, via)
+      rest.unshift(first!)
+    }
+    for (const ref of rest) await relay(this.state, ref.app, { type: 'settle', thread: ref.thread, message: ref.message, note: `✓ Answered ${where}: ${label}` })
+  }
+
+  // Takes back an answer given in the app or on a call: its buttons come back and its thread hears.
+  async undo(id: string, via: string) {
+    const answered = this.marks.answers[id]
+    if (answered) {
+      delete this.marks.answers[id]
+      this.saveMarks()
+      const curated = this.result?.asks.find(ask => ask.id === id)
+      return curated && this.tell(curated.task, `(took back) ${curated.question}: ${answered.label}`, via)
+    }
+    for (const ref of this.refs(id)) {
+      const asked = this.asked(ref)
+      if (asked && (WHERE[asked.answer?.via ?? ''] || asked.settled?.note.startsWith('✓ Answered'))) await relay(this.state, ref.app, { type: 'reopen', thread: ref.thread, message: ref.message, via })
+    }
+  }
+
+  // A stuck item's one action: hex's General is asked to do it, or it's put away until it changes.
+  async act(id: string) {
+    const item = this.view.stuck.find(item => item.id === id)
+    if (!item) throw new Error('that is no longer stuck')
+    if (item.request) {
+      await this.tell(this.general(), item.request, 'app')
+      this.marks.sent[id] = now()
+    } else this.marks.dismissed[id] = now()
+    this.saveMarks()
+  }
+
+  read(id: string) {
+    this.marks.read[id] = now()
+    this.saveMarks()
+  }
+
+  private refs(id: string): Ref[] {
+    const curated = this.result?.asks.find(ask => ask.id === id)
+    if (curated) return curated.refs ?? []
+    const ref = parseRef(id)
+    return ref ? [ref] : []
+  }
+
+  private asked(ref: Ref) {
+    return this.ledgers.get(ref.app)?.find(ask => ask.thread === ref.thread && ask.message === ref.message)
+  }
+
+  private open(ref: Ref) {
+    const asked = this.asked(ref)
+    return !!asked && !asked.answer && !asked.settled
+  }
+
+  private tell(task: string, content: string, via: string) {
+    const [app, ...thread] = task.split(':')
+    return relay(this.state, app!, { type: 'inbound', thread: thread.join(':'), content, meta: { user: `hex ${via}` } })
+  }
+
+  private general() {
+    const general = [...this.names.keys()].find(task => /^telegram:-\d+$/.test(task))
+    if (!general) throw new Error('hex has no Telegram General to send this to')
+    return general
+  }
+
+  private schedule() {
+    clearTimeout(this.pending)
+    this.pending = setTimeout(() => this.build(), 30)
+  }
+
+  private build() {
+    this.names.clear()
+    this.pins.clear()
+    for (const app of apps(this.state)) {
+      const book = readJson(join(this.state, app, 'ledger.json'))
+      this.ledgers.set(app, book?.asks ?? [])
+      for (const [thread, pin] of Object.entries<any>(book?.pins ?? {})) if (pin.text) this.pins.set(`${app}:${thread}`, pin.text)
+      for (const [thread, known] of Object.entries<any>(readJson(join(this.state, app, 'threads.json')) ?? {})) this.names.set(`${app}:${thread}`, known.name ?? thread)
+    }
+    this.result = readJson(join(this.state, 'voice', 'check.json'))
+    this.notice()
+    const used = new Set<string>()
+    const curated = (this.result?.asks ?? []).flatMap(ask => {
+      for (const ref of ask.refs ?? []) used.add(refId(ref))
+      const live = ask.refs?.length ? ask.refs.some(ref => this.open(ref)) : !this.marks.answers[ask.id]
+      return live ? [this.dress(ask)] : []
+    })
+    const raw = [...this.ledgers].flatMap(([app, asks]) =>
+      asks.filter(ask => !ask.answer && !ask.settled && !used.has(refId({ app, ...ask }))).map(ask => this.dress(fromLedger(app, ask))),
+    )
+    raw.sort((a, b) => b.at.localeCompare(a.at))
+    const checked = this.result?.at ?? ''
+    const stuck = [...this.t3.stuck, ...(this.result?.stuck ?? []).map(item => ({ ...item, app: 'hex' }))]
+      .filter(item => !this.marks.dismissed[item.id])
+      .map(item => ({ ...item, ...(this.marks.sent[item.id] && { sent: this.marks.sent[item.id] }) }))
+    const view: Omit<View, 'version'> = {
+      asks: [...raw.filter(ask => ask.at > checked), ...curated, ...raw.filter(ask => ask.at <= checked)],
+      stuck,
+      fresh: this.t3.fresh.map(item => ({ ...item, read: !!this.marks.read[item.id] })),
+      check: this.result ? { at: this.result.at, why: this.result.why, fixed: this.result.fixed.length, flagged: this.result.flagged.length } : null,
+    }
+    if (JSON.stringify(view) === JSON.stringify(this.view)) return
+    const moved = view.asks.length !== this.view.asks.length || view.stuck.length !== this.view.stuck.length
+    this.view = view
+    this.changed()
+    if (moved) this.counts.changed()
+  }
+
+  // A pinned post that changed or a T3 run that ended starts a check; the first read only takes note.
+  private notice() {
+    const now = {
+      pins: JSON.stringify([...this.pins]),
+      t3: JSON.stringify([this.t3.stuck, this.t3.fresh].map(items => items.map(item => item.id))),
+    }
+    const why = !this.seen ? undefined : now.pins !== this.seen.pins ? 'a pinned post changed' : now.t3 !== this.seen.t3 ? 'a T3 run ended' : undefined
+    this.seen = now
+    if (why) this.check(why)
+  }
+
+  private dress(ask: Curated): Ask {
+    const { refs, ...rest } = ask
+    const ref = refs?.[0]
+    return {
+      ...rest,
+      app: ref?.app ?? ask.task.split(':')[0]!,
+      topic: this.names.get(ask.task) ?? ask.task.split(':').at(-1)!,
+      ...(ref && link(ref) && { link: link(ref) }),
+    }
+  }
+
+  private saveMarks() {
+    const since = new Date(Date.now() - KEEP).toISOString()
+    for (const book of Object.values(this.marks) as Record<string, string | Answer>[])
+      for (const [id, at] of Object.entries(book)) if ((typeof at === 'string' ? at : at.at) < since) delete book[id]
+    const file = join(this.state, 'voice', 'marks.json')
+    writeFileSync(`${file}.tmp`, JSON.stringify(this.marks, null, 1) + '\n')
+    renameSync(`${file}.tmp`, file)
+    this.schedule()
+  }
+}
+
+// A question as its thread asked it: its first line is the question and the rest its context; the
+// option the thread marked as its pick wears it.
+export function fromLedger(app: string, asked: Asked): Curated {
+  const lines = plain(asked.text)
+    .split('\n')
+    .map(line => line.trim())
+    .filter(Boolean)
+  const options = asked.options.map(value => {
+    const label = value.replace(PICK, '').trim() || value
+    return { label, value, ...(label !== value && { pick: true }) }
+  })
+  const context = lines.slice(1).join(' ')
+  return {
+    id: refId({ app, ...asked }),
+    kind: asked.options.length <= 2 ? 'yesno' : 'pick',
+    task: `${app}:${asked.thread}`,
+    at: asked.at,
+    question: clip(lines[0] ?? '', 160).replace(/:$/, ''),
+    ...(context && { context: clip(context, 280) }),
+    options,
+    refs: [{ app, thread: asked.thread, message: asked.message }],
+  }
+}
+
+export function refId({ app, thread, message }: Ref) {
+  return `${app}:${thread}:${message}`
+}
+
+function parseRef(id: string): Ref | undefined {
+  const [, app, thread, message] = id.match(/^(\w+):(.+):(\d+)$/) ?? []
+  return app && thread ? { app, thread, message: Number(message) } : undefined
+}
+
+function link({ app, thread, message }: Ref) {
+  if (app !== 'telegram' || !thread.startsWith('-100')) return
+  const [chat, topic] = thread.slice(4).split(':')
+  return topic ? `https://t.me/c/${chat}/${topic}/${message}` : `https://t.me/c/${chat}/${message}`
+}
+
+function plain(text: string) {
+  return text
+    .replace(/```[\s\S]*?(```|$)/g, '')
+    .replace(/\*\*|__|`/g, '')
+    .replace(/^#+\s+/gm, '')
+}
+
+function clip(text: string, max: number) {
+  return text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text
+}
+
+function apps(state: string) {
+  try {
+    return readdirSync(state).filter(app => app !== 'voice')
+  } catch {
+    return []
+  }
+}
+
+function readMarks(file: string): Marks {
+  const marks = readJson(file) ?? {}
+  return { answers: marks.answers ?? {}, sent: marks.sent ?? {}, dismissed: marks.dismissed ?? {}, read: marks.read ?? {} }
+}
+
+function readJson(path: string) {
+  try {
+    return JSON.parse(readFileSync(path, 'utf8'))
+  } catch {}
+}
+
+function watchDir(dir: string, changed: (file: string | null) => void) {
+  try {
+    const watcher = watch(dir, (_, file) => changed(file))
+    return () => watcher.close()
+  } catch {
+    return () => {}
+  }
+}
+
+function now() {
+  return new Date().toISOString()
+}
