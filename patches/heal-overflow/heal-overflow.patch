+++ b/external_plugins/voice/asks.ts
@@ -0,0 +1,348 @@
+import { readdirSync, readFileSync, renameSync, watch, writeFileSync } from 'fs'
+import { join } from 'path'
+import type { Ask as Asked } from '../../hub/ledger.ts'
+import { Changes } from './changes.ts'
+import { Check } from './check.ts'
+import { relay } from './relay.ts'
+import { T3, type Fresh, type Stuck } from './t3.ts'
+
+export type Kind = 'pick' | 'yesno' | 'do' | 'look'
+// value: the button's own label, when the option stands for one; url: an option that opens a page.
+export type Option = { label: string; value?: string; pick?: boolean; url?: string }
+export type Answer = { label: string; at: string; via: string }
+export type Ref = { app: string; thread: string; message: number }
+export type Ask = {
+  id: string
+  kind: Kind
+  task: string
+  topic: string
+  at: string
+  question: string
+  context?: string
+  options: Option[]
+  tag?: string
+  places?: string[]
+  link?: string
+}
+// hex's check rewrites the raw questions into these: one per decision, however many places asked
+// it (refs), in the order that unblocks the most, with its pick and what it costs.
+export type Curated = Omit<Ask, 'topic' | 'link'> & { refs?: Ref[] }
+export type Note = { title: string; text: string; did?: string }
+export type CheckResult = {
+  at: string
+  why: string
+  read: Record<string, number>
+  asks: Curated[]
+  fixed: Note[]
+  flagged: Note[]
+  stuck: Stuck[]
+  inputs?: string
+}
+export type View = {
+  version: number
+  asks: Ask[]
+  stuck: (Stuck & { sent?: string })[]
+  fresh: (Fresh & { read: boolean })[]
+  check: { at: string; why: string; fixed: number; flagged: number } | null
+}
+type Marks = { answers: Record<string, Answer>; sent: Record<string, string>; dismissed: Record<string, string>; read: Record<string, string> }
+
+const KEEP = 14 * 24 * 60 * 60_000
+const WHERE: Record<string, string> = { app: 'in the app', call: 'on a call' }
+const PICK = /\s*[(\[]?\s*(?:←\s*)?(?:(?:my|hex[’']s) pick)\s*[)\]]?/i
+
+// Everything waiting on the owner, in one list: each question a hex thread asked with buttons or a
+// poll and nobody has answered (from each app's ledger), as hex's check last rewrote them; what's
+// stuck and what finished since he looked (T3 Code's own records, and what the check found). An
+// answer goes back the way a tap in the chat app would, through that app's hub.
+export class Asks extends Changes {
+  view: Omit<View, 'version'> = { asks: [], stuck: [], fresh: [], check: null }
+  counts = new Changes()
+  private ledgers = new Map<string, Asked[]>()
+  private names = new Map<string, string>()
+  private pins = new Map<string, string>()
+  private result?: CheckResult
+  private marks: Marks
+  private pending?: ReturnType<typeof setTimeout>
+  private stops: (() => void)[] = []
+  private t3: T3
+  private check: (why: string) => void
+  private seen?: { pins: string; t3: string }
+
+  constructor(
+    private state: string,
+    { t3Database, check = why => new Check(state).start(why) }: { t3Database?: string; check?: (why: string) => void } = {},
+  ) {
+    super()
+    this.check = check
+    this.marks = readMarks(join(state, 'voice', 'marks.json'))
+    this.t3 = new T3(() => this.schedule(), t3Database)
+    for (const app of apps(state)) this.stops.push(watchDir(join(state, app), file => (file === 'ledger.json' || file === 'threads.json') && this.schedule()))
+    this.stops.push(watchDir(join(state, 'voice'), file => file === 'check.json' && this.schedule()))
+    this.build()
+  }
+
+  get lastCheck() {
+    return this.result
+  }
+
+  // Tasks opened with questions newer than the last check, or a call ended: hex checks again.
+  opened() {
+    const checked = this.result?.at ?? ''
+    if ([...this.ledgers.values()].some(asks => asks.some(ask => !ask.answer && !ask.settled && ask.at > checked))) this.check('you opened Tasks')
+  }
+
+  called() {
+    this.check('a call ended')
+  }
+
+  close() {
+    clearTimeout(this.pending)
+    this.t3.close()
+    for (const stop of this.stops) stop()
+  }
+
+  find(id: string) {
+    return this.view.asks.find(ask => ask.id === id)
+  }
+
+  // The thread's own questions and its pinned status post, for its page.
+  of(task: string) {
+    return { asks: this.view.asks.filter(ask => ask.task === task), ...(this.pins.has(task) && { pin: this.pins.get(task) }) }
+  }
+
+  async answer(id: string, label: string, via: string) {
+    const ask = this.find(id)
+    if (!ask) throw new Error('that question is already answered or settled')
+    const option = ask.options.find(option => option.label === label)
+    const refs = this.refs(id).filter(ref => this.open(ref))
+    const where = WHERE[via] ?? via
+    if (!refs.length) {
+      this.marks.answers[id] = { label, at: now(), via }
+      this.saveMarks()
+      return this.tell(ask.task, `(answered ${where}) ${ask.question}: ${label}`, via)
+    }
+    const [first, ...rest] = refs
+    const value = option?.value ?? label
+    if (this.asked(first!)!.options.includes(value)) await relay(this.state, first!.app, { type: 'answer', thread: first!.thread, message: first!.message, label: value, via })
+    else {
+      await this.tell(`${first!.app}:${first!.thread}`, `(answered ${where}) ${ask.question}: ${label}`, via)
+      rest.unshift(first!)
+    }
+    for (const ref of rest) await relay(this.state, ref.app, { type: 'settle', thread: ref.thread, message: ref.message, note: `✓ Answered ${where}: ${label}` })
+  }
+
+  // Takes back an answer given in the app or on a call: its buttons come back and its thread hears.
+  async undo(id: string, via: string) {
+    const answered = this.marks.answers[id]
+    if (answered) {
+      delete this.marks.answers[id]
+      this.saveMarks()
+      const curated = this.result?.asks.find(ask => ask.id === id)
+      return curated && this.tell(curated.task, `(took back) ${curated.question}: ${answered.label}`, via)
+    }
+    for (const ref of this.refs(id)) {
+      const asked = this.asked(ref)
+      if (asked && (WHERE[asked.answer?.via ?? ''] || asked.settled?.note.startsWith('✓ Answered'))) await relay(this.state, ref.app, { type: 'reopen', thread: ref.thread, message: ref.message, via })
+    }
+  }
+
+  // A stuck item's one action: hex's General is asked to do it, or it's put away until it changes.
+  async act(id: string) {
+    const item = this.view.stuck.find(item => item.id === id)
+    if (!item) throw new Error('that is no longer stuck')
+    if (item.request) {
+      await this.tell(this.general(), item.request, 'app')
+      this.marks.sent[id] = now()
+    } else this.marks.dismissed[id] = now()
+    this.saveMarks()
+  }
+
+  read(id: string) {
+    this.marks.read[id] = now()
+    this.saveMarks()
+  }
+
+  private refs(id: string): Ref[] {
+    const curated = this.result?.asks.find(ask => ask.id === id)
+    if (curated) return curated.refs ?? []
+    const ref = parseRef(id)
+    return ref ? [ref] : []
+  }
+
+  private asked(ref: Ref) {
+    return this.ledgers.get(ref.app)?.find(ask => ask.thread === ref.thread && ask.message === ref.message)
+  }
+
+  private open(ref: Ref) {
+    const asked = this.asked(ref)
+    return !!asked && !asked.answer && !asked.settled
+  }
+
+  private tell(task: string, content: string, via: string) {
+    const [app, ...thread] = task.split(':')
+    return relay(this.state, app!, { type: 'inbound', thread: thread.join(':'), content, meta: { user: `hex ${via}` } })
+  }
+
+  private general() {
+    const general = [...this.names.keys()].find(task => /^telegram:-\d+$/.test(task))
+    if (!general) throw new Error('hex has no Telegram General to send this to')
+    return general
+  }
+
+  private schedule() {
+    clearTimeout(this.pending)
+    this.pending = setTimeout(() => this.build(), 30)
+  }
+
+  private build() {
+    this.names.clear()
+    this.pins.clear()
+    for (const app of apps(this.state)) {
+      const book = readJson(join(this.state, app, 'ledger.json'))
+      this.ledgers.set(app, book?.asks ?? [])
+      for (const [thread, pin] of Object.entries<any>(book?.pins ?? {})) if (pin.text) this.pins.set(`${app}:${thread}`, pin.text)
+      for (const [thread, known] of Object.entries<any>(readJson(join(this.state, app, 'threads.json')) ?? {})) this.names.set(`${app}:${thread}`, known.name ?? thread)
+    }
+    this.result = readJson(join(this.state, 'voice', 'check.json'))
+    this.notice()
+    const used = new Set<string>()
+    const curated = (this.result?.asks ?? []).flatMap(ask => {
+      for (const ref of ask.refs ?? []) used.add(refId(ref))
+      const live = ask.refs?.length ? ask.refs.some(ref => this.open(ref)) : !this.marks.answers[ask.id]
+      return live ? [this.dress(ask)] : []
+    })
+    const raw = [...this.ledgers].flatMap(([app, asks]) =>
+      asks.filter(ask => !ask.answer && !ask.settled && !used.has(refId({ app, ...ask }))).map(ask => this.dress(fromLedger(app, ask))),
+    )
+    raw.sort((a, b) => b.at.localeCompare(a.at))
+    const checked = this.result?.at ?? ''
+    const stuck = [...this.t3.stuck, ...(this.result?.stuck ?? [])]
+      .filter(item => !this.marks.dismissed[item.id])
+      .map(item => ({ ...item, ...(this.marks.sent[item.id] && { sent: this.marks.sent[item.id] }) }))
+    const view: Omit<View, 'version'> = {
+      asks: [...raw.filter(ask => ask.at > checked), ...curated, ...raw.filter(ask => ask.at <= checked)],
+      stuck,
+      fresh: this.t3.fresh.map(item => ({ ...item, read: !!this.marks.read[item.id] })),
+      check: this.result ? { at: this.result.at, why: this.result.why, fixed: this.result.fixed.length, flagged: this.result.flagged.length } : null,
+    }
+    if (JSON.stringify(view) === JSON.stringify(this.view)) return
+    const moved = view.asks.length !== this.view.asks.length || view.stuck.length !== this.view.stuck.length
+    this.view = view
+    this.changed()
+    if (moved) this.counts.changed()
+  }
+
+  // A pinned post that changed or a T3 run that ended starts a check; the first read only takes note.
+  private notice() {
+    const now = {
+      pins: JSON.stringify([...this.pins]),
+      t3: JSON.stringify([this.t3.stuck, this.t3.fresh].map(items => items.map(item => item.id))),
+    }
+    const why = !this.seen ? undefined : now.pins !== this.seen.pins ? 'a pinned post changed' : now.t3 !== this.seen.t3 ? 'a T3 run ended' : undefined
+    this.seen = now
+    if (why) this.check(why)
+  }
+
+  private dress(ask: Curated): Ask {
+    const { refs, ...rest } = ask
+    const ref = refs?.[0]
+    return {
+      ...rest,
+      topic: this.names.get(ask.task) ?? ask.task.split(':').at(-1)!,
+      ...(ref && link(ref) && { link: link(ref) }),
+    }
+  }
+
+  private saveMarks() {
+    const since = new Date(Date.now() - KEEP).toISOString()
+    for (const book of Object.values(this.marks) as Record<string, string | Answer>[])
+      for (const [id, at] of Object.entries(book)) if ((typeof at === 'string' ? at : at.at) < since) delete book[id]
+    const file = join(this.state, 'voice', 'marks.json')
+    writeFileSync(`${file}.tmp`, JSON.stringify(this.marks, null, 1) + '\n')
+    renameSync(`${file}.tmp`, file)
+    this.schedule()
+  }
+}
+
+// A question as its thread asked it: its first line is the question and the rest its context; the
+// option the thread marked as its pick wears it.
+export function fromLedger(app: string, asked: Asked): Curated {
+  const lines = plain(asked.text)
+    .split('\n')
+    .map(line => line.trim())
+    .filter(Boolean)
+  const options = asked.options.map(value => {
+    const label = value.replace(PICK, '').trim() || value
+    return { label, value, ...(label !== value && { pick: true }) }
+  })
+  const context = lines.slice(1).join(' ')
+  return {
+    id: refId({ app, ...asked }),
+    kind: asked.options.length <= 2 ? 'yesno' : 'pick',
+    task: `${app}:${asked.thread}`,
+    at: asked.at,
+    question: clip(lines[0] ?? '', 160).replace(/:$/, ''),
+    ...(context && { context: clip(context, 280) }),
+    options,
+    refs: [{ app, thread: asked.thread, message: asked.message }],
+  }
+}
+
+export function refId({ app, thread, message }: Ref) {
+  return `${app}:${thread}:${message}`
+}
+
+function parseRef(id: string): Ref | undefined {
+  const [, app, thread, message] = id.match(/^(\w+):(.+):(\d+)$/) ?? []
+  return app && thread ? { app, thread, message: Number(message) } : undefined
+}
+
+function link({ app, thread, message }: Ref) {
+  if (app !== 'telegram' || !thread.startsWith('-100')) return
+  const [chat, topic] = thread.slice(4).split(':')
+  return topic ? `https://t.me/c/${chat}/${topic}/${message}` : `https://t.me/c/${chat}/${message}`
+}
+
+function plain(text: string) {
+  return text
+    .replace(/```[\s\S]*?(```|$)/g, '')
+    .replace(/\*\*|__|`/g, '')
+    .replace(/^#+\s+/gm, '')
+}
+
+function clip(text: string, max: number) {
+  return text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text
+}
+
+function apps(state: string) {
+  try {
+    return readdirSync(state).filter(app => app !== 'voice')
+  } catch {
+    return []
+  }
+}
+
+function readMarks(file: string): Marks {
+  const marks = readJson(file) ?? {}
+  return { answers: marks.answers ?? {}, sent: marks.sent ?? {}, dismissed: marks.dismissed ?? {}, read: marks.read ?? {} }
+}
+
+function readJson(path: string) {
+  try {
+    return JSON.parse(readFileSync(path, 'utf8'))
+  } catch {}
+}
+
+function watchDir(dir: string, changed: (file: string | null) => void) {
+  try {
+    const watcher = watch(dir, (_, file) => changed(file))
+    return () => watcher.close()
+  } catch {
+    return () => {}
+  }
+}
+
+function now() {
+  return new Date().toISOString()
+}
diff --git a/external_plugins/voice/check.ts b/external_plugins/voice/check.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9bca8dd83068258c6d31a46b33e256a39eecc5c3
--- /dev/null
+++ b/external_plugins/voice/check.ts
@@ -0,0 +1,290 @@
+import { spawn } from 'child_process'
+import { createHash } from 'crypto'
+import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from 'fs'
+import { homedir, tmpdir } from 'os'
+import { dirname, join } from 'path'
+import type { Ask as Asked } from '../../hub/ledger.ts'
+import type { CheckResult, Curated, Ref } from './asks.ts'
+import { relay } from './relay.ts'
+import { T3, type Stuck } from './t3.ts'
+
+type Verdict = Pick<CheckResult, 'asks' | 'fixed' | 'flagged' | 'stuck'> & { settle: (Ref & { note: string })[] }
+
+const MODEL = process.env.HEX_CHECK_MODEL ?? 'claude-opus-5-5'
+const CALLS = join(homedir(), '.claude', 'channels', 'voice', 'calls')
+const RECENT = 3 * 24 * 60 * 60_000
+const LONG = 2400
+
+// hex's check: an Opus pass over everything waiting on the owner, started by real events (a pinned
+// post changed, a T3 run ended, a call ended, Tasks opened after a change). It rewrites the raw
+// questions into one list (repeats merged, its pick, what each unblocks), settles the questions the
+// records show are already decided or done, and flags what it can't settle. It answers nothing for
+// him. One runs at a time in a process of its own, so it outlives the voice session that started
+// it. Events that land while it runs leave one mark, so a burst of them costs one more pass at
+// most, and a pass whose records haven't changed since the last one skips Opus.
+export class Check {
+  private dir: string
+
+  constructor(private state: string) {
+    this.dir = join(state, 'voice', 'check')
+    mkdirSync(this.dir, { recursive: true })
+  }
+
+  get running() {
+    const pid = Number(read(join(this.dir, 'lock')))
+    return !!pid && alive(pid)
+  }
+
+  start(why: string) {
+    writeFileSync(join(this.dir, 'next'), why)
+    if (!this.running) spawn(process.execPath, [import.meta.path, this.state], { detached: true, stdio: 'ignore' }).unref()
+  }
+}
+
+// Whoever holds the lock runs a pass per mark until none is left; a mark left in the moment the
+// lock is let go is picked up again, by this process or the one that took the lock.
+async function run(state: string) {
+  const dir = join(state, 'voice', 'check')
+  while (existsSync(join(dir, 'next')) && hold(join(dir, 'lock'))) {
+    try {
+      for (let why = take(join(dir, 'next')); why; why = take(join(dir, 'next'))) {
+        await pass(state, why).then(
+          () => rmSync(join(dir, 'error'), { force: true }),
+          error => writeFileSync(join(dir, 'error'), `${new Date().toISOString()} ${why}: ${error instanceof Error ? error.message : error}\n`),
+        )
+      }
+    } finally {
+      rmSync(join(dir, 'lock'), { force: true })
+    }
+  }
+}
+
+function hold(lock: string): boolean {
+  try {
+    writeFileSync(lock, String(process.pid), { flag: 'wx' })
+    return true
+  } catch {
+    if (alive(Number(read(lock)))) return false
+    rmSync(lock, { force: true })
+    return hold(lock)
+  }
+}
+
+async function pass(state: string, why: string) {
+  const started = new Date().toISOString()
+  const records = gather(state)
+  const inputs = digest(records)
+  if (records.previous?.inputs === inputs) return
+  const verdict = vet(await claude(prompt(records), dirname(state)), records.ledgers)
+  for (const ref of verdict.settle) await relay(state, ref.app, { type: 'settle', thread: ref.thread, message: ref.message, note: ref.note }).catch(error => process.stderr.write(`voice: check: ${error}\n`))
+  const result: CheckResult = {
+    at: started,
+    why,
+    read: {
+      'pinned posts': Object.values(records.pins).length,
+      questions: records.open.length,
+      'T3 items': records.t3.stuck.length + records.t3.fresh.length,
+      calls: records.calls.length,
+    },
+    asks: verdict.asks,
+    fixed: verdict.fixed,
+    flagged: verdict.flagged,
+    stuck: verdict.stuck,
+    inputs,
+  }
+  const file = join(state, 'voice', 'check.json')
+  writeFileSync(`${file}.tmp`, JSON.stringify(result, null, 1) + '\n')
+  renameSync(`${file}.tmp`, file)
+}
+
+function gather(state: string) {
+  const now = Date.now()
+  const recent = new Date(now - RECENT).toISOString()
+  const names: Record<string, string> = {}
+  const ledgers: Record<string, Asked[]> = {}
+  const pins: Record<string, string> = {}
+  for (const app of readdirSync(state).filter(app => app !== 'voice')) {
+    for (const [thread, known] of Object.entries<any>(json(join(state, app, 'threads.json')) ?? {})) names[`${app}:${thread}`] = known.name ?? thread
+    const book = json(join(state, app, 'ledger.json'))
+    ledgers[app] = book?.asks ?? []
+    for (const [thread, pin] of Object.entries<any>(book?.pins ?? {})) if (pin.text) pins[`${app}:${thread}`] = clip(pin.text, LONG)
+  }
+  const shown = (app: string, ask: Asked) => ({
+    ref: { app, thread: ask.thread, message: ask.message },
+    topic: names[`${app}:${ask.thread}`] ?? ask.thread,
+    at: ask.at,
+    text: clip(ask.text, 700),
+    options: ask.options,
+    ...(ask.poll && { poll: true }),
+    ...(ask.answer && { answer: ask.answer }),
+    ...(ask.settled && { settled: ask.settled }),
+  })
+  const open = Object.entries(ledgers).flatMap(([app, asks]) => asks.filter(ask => !ask.answer && !ask.settled).map(ask => shown(app, ask)))
+  const closed = Object.entries(ledgers).flatMap(([app, asks]) => asks.filter(ask => (ask.answer || ask.settled) && ask.at > recent).map(ask => shown(app, ask)))
+  const t3 = new T3(() => {})
+  const t3Now = t3.query(now)
+  t3.close()
+  const calls = list(CALLS)
+    .filter(file => file.endsWith('.json') && statSync(join(CALLS, file)).mtimeMs > now - RECENT)
+    .map(file => json(join(CALLS, file)))
+    .filter(call => call?.ended && (call.summary || call.waiting?.length))
+    .map(call => ({ title: call.title, ended: call.ended, summary: call.summary, waiting: call.waiting ?? [] }))
+  return { now: new Date(now).toISOString(), threads: names, open, closed, pins: Object.fromEntries(Object.entries(pins).map(([task, text]) => [`${task} (${names[task] ?? task})`, text])), calls, t3: t3Now, previous: json(join(state, 'voice', 'check.json')), ledgers }
+}
+
+// What a pass reads, as one fingerprint: the same records give the same verdict.
+export function digest({ open, closed, pins, calls, t3 }: ReturnType<typeof gather>) {
+  return createHash('sha256').update(JSON.stringify({ open, closed, pins, calls, t3 })).digest('hex')
+}
+
+function prompt({ ledgers, ...records }: ReturnType<typeof gather>) {
+  return `You're hex's check. hex is Bassim's personal assistant: it works for him in many threads at once (Telegram topics, T3 Code threads, calls with its voice app), and each thread asks him things: questions with buttons, polls, the "waiting on you" part of its pinned status post, and the waiting lines of a call's wrap-up. They pile up in dozens of places and many go stale. Your pass turns them into one honest list in his voice app, where he answers each in place.
+
+What he asked for, in his words: "the ability to better manage my tasks with hex ... we could give an even better idea for things that need to get done. And this could all be done by looking through the transcript, gathering, auditing, analyzing, figuring out, and also checking on any work that was done by other agents ... that might be waiting for other things ... older work from yesterday or two days ago, that might not have been done ... such that I can help ship more and get unblocked".
+
+The records are below as JSON: every open question asked with buttons or a poll (open, each with its ref), the ones answered or settled lately (closed), each thread's pinned post (pins), calls' wrap-ups (calls), what T3 Code shows as stuck or newly finished (t3; the app lists those already), and your previous pass (previous). To confirm something before you settle it, read his records: conversations in ~/hex/log/ (one markdown file per day and session; rg them), threads in ~/hex/state/*/threads.json, session transcripts under ~/.claude/projects/, project notes under ~/hex/projects/.
+
+Return:
+- asks: one entry per decision or action that is still his, however many places asked it. refs lists every open question it stands for (copy their ref objects), places names the threads that asked it. id is "check:" plus a short slug, the same slug as in your previous pass for the same thing. task is the thread it belongs to ("<app>:<thread id>", from threads). question is one short plain line (60 characters at most). context is one or two plain sentences on what it unblocks or costs. options are short labels; mark the thread's own pick with pick (one at most, only where the thread made one); when an option stands for a button, value is that button's exact text from the first ref. kind is pick (one of several), yesno (two ways), do (only his hands can do it, like a sign-in, a purchase, a recording: options like Done and Later, plus one with url when a page opens it) or look (something to watch or read, one option with url when there's a link). tag is "money" when an option spends money, or "unblocks N" when N other things wait on it. Order: what unblocks the most first, even when it costs money, then the quickest; other money and anything sent in his name last. Asks from pinned posts and call wrap-ups have no refs; their task is the thread they came from.
+- settle: open questions the records show are already decided or done: decided in a conversation or a call, replaced by a later question, or the thing already happened. note is what the question's Telegram buttons will say instead, like "Settled: Pro is on" (40 characters at most). Settle only what the records show; anything you're unsure of stays an ask.
+- fixed: what you settled or merged, the way he'd read it: title (the thing), text (the evidence, with message numbers), did (what you did, in a few words).
+- flagged: what he should look at that you can't settle yourself, like the same thing asked with different options, or a question days old whose work has stalled: title and text.
+- stuck: work stopped with nobody moving it that the t3 list doesn't already show, like a failing service a pinned post mentions: id (a short slug), title, why (one sentence), action (one or two words, like Restore or Look), mark (paused or failed), at, and request: what hex should do when he taps the action, as a message to hex.
+
+Every answer is his: an ask stays open until he answers it. Leave health details and phone numbers out of everything you write.
+
+${JSON.stringify(records)}`
+}
+
+const NOTE = { type: 'object', properties: { title: { type: 'string' }, text: { type: 'string' }, did: { type: 'string' } }, required: ['title', 'text'] }
+const REF = { type: 'object', properties: { app: { type: 'string' }, thread: { type: 'string' }, message: { type: 'number' } }, required: ['app', 'thread', 'message'] }
+const SCHEMA = {
+  type: 'object',
+  properties: {
+    asks: {
+      type: 'array',
+      items: {
+        type: 'object',
+        properties: {
+          id: { type: 'string' },
+          kind: { enum: ['pick', 'yesno', 'do', 'look'] },
+          task: { type: 'string' },
+          at: { type: 'string' },
+          question: { type: 'string' },
+          context: { type: 'string' },
+          options: {
+            type: 'array',
+            items: { type: 'object', properties: { label: { type: 'string' }, value: { type: 'string' }, pick: { type: 'boolean' }, url: { type: 'string' } }, required: ['label'] },
+          },
+          tag: { type: 'string' },
+          places: { type: 'array', items: { type: 'string' } },
+          refs: { type: 'array', items: REF },
+        },
+        required: ['id', 'kind', 'task', 'at', 'question', 'options'],
+      },
+    },
+    settle: { type: 'array', items: { ...REF, properties: { ...REF.properties, note: { type: 'string' } }, required: [...REF.required, 'note'] } },
+    fixed: { type: 'array', items: NOTE },
+    flagged: { type: 'array', items: NOTE },
+    stuck: {
+      type: 'array',
+      items: {
+        type: 'object',
+        properties: { id: { type: 'string' }, title: { type: 'string' }, why: { type: 'string' }, action: { type: 'string' }, mark: { enum: ['paused', 'failed'] }, at: { type: 'string' }, request: { type: 'string' } },
+        required: ['id', 'title', 'why', 'action', 'mark', 'at'],
+      },
+    },
+  },
+  required: ['asks', 'settle', 'fixed', 'flagged', 'stuck'],
+}
+
+// A read-only pass: it reads files and searches, and its only effect is the JSON it returns.
+function claude(input: string, hexDir: string) {
+  const args = ['-p', '--model', MODEL, '--effort', 'medium', '--output-format', 'json', '--json-schema', JSON.stringify(SCHEMA), '--tools', 'Read,Grep,Glob', '--strict-mcp-config', '--setting-sources', 'project', '--no-session-persistence', '--add-dir', hexDir, join(homedir(), '.claude', 'projects')]
+  const cwd = mkdtempSync(join(tmpdir(), 'hex-check-'))
+  return new Promise<Verdict>((resolve, reject) => {
+    const child = spawn('claude', args, { cwd, stdio: ['pipe', 'pipe', 'pipe'] })
+    let out = ''
+    let err = ''
+    child.stdout.on('data', chunk => (out += chunk))
+    child.stderr.on('data', chunk => (err += chunk))
+    child.on('error', reject)
+    child.on('close', code => {
+      rmSync(cwd, { recursive: true, force: true })
+      try {
+        const result = JSON.parse(out)
+        if (result.is_error || !result.structured_output) throw new Error(result.result ?? 'no result')
+        resolve(result.structured_output)
+      } catch (error) {
+        reject(new Error(`the check's claude exited ${code}: ${error} ${err.slice(-500)}`))
+      }
+    })
+    child.stdin.end(input)
+  })
+}
+
+// What the pass returned, held to the records: refs and settles name real open questions, a value
+// is a real button, and a question it settles isn't also one it lists.
+export function vet(verdict: Verdict, ledgers: Record<string, Asked[]>): Verdict {
+  const find = (ref: Ref) => ledgers[ref.app]?.find(ask => ask.thread === ref.thread && ask.message === ref.message)
+  const open = (ref: Ref) => {
+    const ask = find(ref)
+    return !!ask && !ask.answer && !ask.settled
+  }
+  const asks: Curated[] = verdict.asks.map(ask => {
+    const refs = (ask.refs ?? []).filter(open)
+    const buttons = refs[0] ? find(refs[0])!.options : []
+    return {
+      ...ask,
+      id: ask.id.startsWith('check:') ? ask.id : `check:${ask.id}`,
+      options: ask.options.map(({ value, ...option }) => ({ ...option, ...(value && buttons.includes(value) && { value }) })),
+      ...(ask.refs && { refs }),
+    }
+  })
+  const listed = new Set(asks.flatMap(ask => ask.refs ?? []).map(ref => `${ref.app} ${ref.thread} ${ref.message}`))
+  return {
+    asks,
+    settle: verdict.settle.filter(ref => open(ref) && !listed.has(`${ref.app} ${ref.thread} ${ref.message}`)).map(ref => ({ ...ref, note: ref.note.slice(0, 60) })),
+    fixed: verdict.fixed,
+    flagged: verdict.flagged,
+    stuck: verdict.stuck.map((item: Stuck) => ({ ...item, id: item.id.startsWith('check-') ? item.id : `check-${item.id}` })),
+  }
+}
+
+function take(file: string) {
+  const why = read(file)
+  rmSync(file, { force: true })
+  return why || undefined
+}
+
+function read(file: string) {
+  try {
+    return readFileSync(file, 'utf8').trim()
+  } catch {
+    return ''
+  }
+}
+
+function json(file: string) {
+  try {
+    return JSON.parse(readFileSync(file, 'utf8'))
+  } catch {}
+}
+
+function list(dir: string) {
+  return existsSync(dir) ? readdirSync(dir) : []
+}
+
+function clip(text: string, max: number) {
+  return text.length > max ? `${text.slice(0, max - 1)}…` : text
+}
+
+function alive(pid: number) {
+  try {
+    return process.kill(pid, 0)
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === 'EPERM'
+  }
+}
+
+if (import.meta.main) await run(process.argv[2]!)
