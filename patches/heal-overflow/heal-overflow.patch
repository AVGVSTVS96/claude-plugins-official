+import { Database } from 'bun:sqlite'
+import { existsSync, readFileSync, watch } from 'fs'
+import { homedir } from 'os'
+import { join } from 'path'
+
+const T3_HOME = join(homedir(), '.t3', 'userdata')
+const DATABASE = 'statev2.sqlite'
+const REFRESH = 500
+
+// Where a hex thread lives in its own app. Each bot leaves what its links need in its state folder
+// (Discord's server, Telegram's bot name, the channel of every Buzz thread), and T3 Code's own database,
+// read only, says which T3 thread a hex thread is and what it's called there. An app that can't say gives no link.
+// T3_APP_SCHEME is the T3 Code app's URL scheme: t3code, t3code-preview or t3code-dev.
+export class Links {
+  private guild?: string
+  private bot?: string
+  private channels: Record<string, string> = {}
+  private threads = new Map<string, { thread: string; title: string }>()
+  private environment?: string
+  private db?: Database
+  private watcher?: ReturnType<typeof watch>
+  private pending?: ReturnType<typeof setTimeout>
+
+  constructor(
+    private state: string,
+    private changed: () => void,
+    private t3 = T3_HOME,
+    private scheme = process.env.T3_APP_SCHEME || 't3code',
+  ) {
+    const database = join(t3, DATABASE)
+    if (!existsSync(database)) return
+    this.environment = word(readFile(join(t3, 'environment-id'))?.trim())
+    this.db = new Database(database, { readonly: true })
+    this.watcher = watch(t3, (_, file) => file?.startsWith(DATABASE) && this.schedule())
+    this.read()
+  }
+
+  close() {
+    clearTimeout(this.pending)
+    this.watcher?.close()
+    this.db?.close()
+  }
+
+  // The small files the bots keep; read again whenever the threads are.
+  load() {
+    this.guild = word(readJson(join(this.state, 'discord', 'guild.json'))?.id)
+    this.bot = word(readJson(join(this.state, 'telegram', 'bot.json'))?.username)
+    this.channels = readJson(join(this.state, 'buzz', 'channels.json')) ?? {}
+  }
+
+  of(app: string, id: string): string | undefined {
+    switch (app) {
+      case 'telegram': {
+        if (!id.includes(':') && !id.startsWith('-')) return this.bot && `https://t.me/${this.bot}`
+        if (!id.startsWith('-100')) return
+        const [chat, topic = '1'] = id.slice(4).split(':')
+        return `https://t.me/c/${chat}/${topic}`
+      }
+      case 'discord':
+        return this.guild && `https://discord.com/channels/${this.guild}/${id}`
+      case 'buzz': {
+        if (id.includes('-')) return `buzz://channel/${id}`
+        const channel = word(this.channels[id])
+        return channel && `buzz://message?channel=${channel}&id=${id}`
+      }
+      case 't3': {
+        const thread = this.threads.get(id)?.thread
+        return thread && this.environment && `${this.scheme}://threads/${this.environment}/${encodeURIComponent(thread)}`
+      }
+    }
+  }
+
+  // What the thread is called in its own app, where hex knows it by another name: T3 Code's title.
+  title(app: string, id: string): string | undefined {
+    return app === 't3' ? word(this.threads.get(id)?.title) : undefined
+  }
+
+  private schedule() {
+    if (this.pending) return
+    this.pending = setTimeout(() => {
+      this.pending = undefined
+      if (this.read()) this.changed()
+    }, REFRESH)
+  }
+
+  // A hex thread's key is the session id the T3 Code ACP agent holds as its native thread.
+  private read() {
+    try {
+      const rows = this.db!
+        .query<{ key: string; thread: string; title: string }, []>(
+          `select json_extract(p.payload_json, '$.nativeThreadRef.nativeId') key, json_extract(p.payload_json, '$.appThreadId') thread, t.title
+           from orchestration_v2_projection_provider_threads p
+           join orchestration_v2_projection_threads t on t.thread_id = json_extract(p.payload_json, '$.appThreadId')
+           where p.driver = 'acpRegistry' and t.deleted_at is null
+           order by p.updated_at`,
+        )
+        .all()
+      const threads = new Map(rows.map(({ key, thread, title }) => [key, { thread, title }]))
+      if (JSON.stringify([...threads]) === JSON.stringify([...this.threads])) return false
+      this.threads = threads
+      return true
+    } catch (error) {
+      process.stderr.write(`voice: links: couldn't read T3 Code's threads: ${error}\n`)
+      return false
+    }
+  }
+}
+
+function word(value: unknown) {
+  return typeof value === 'string' && value ? value : undefined
+}
+
+function readFile(path: string) {
+  try {
+    return readFileSync(path, 'utf8')
+  } catch {}
+}
+
+function readJson(path: string) {
+  try {
+    return JSON.parse(readFile(path) ?? '')
+  } catch {}
+}
diff --git a/external_plugins/voice/phone.test.ts b/external_plugins/voice/phone.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..baa2fd38fbd0dce08939bfb9af9a3805dff5591a
--- /dev/null
+++ b/external_plugins/voice/phone.test.ts
@@ -0,0 +1,116 @@
+import { expect, test } from 'bun:test'
+import { createHmac } from 'crypto'
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+const CALLER = '+15550001111'
+const TWILIO_TOKEN = 'twilio-secret'
+const HOST = 'voice.test'
+
+// A phone call end to end, with a stand-in for OpenAI's live API and a recorded-style Twilio
+// media stream: the plugin runs as it does in hex, and the test plays the caller's phone.
+async function phoneCall() {
+  const home = mkdtempSync(join(tmpdir(), 'phone-'))
+  const state = join(home, '.claude', 'channels', 'voice')
+  mkdirSync(state, { recursive: true })
+  const audio: string[] = []
+  let voice: Bun.ServerWebSocket<unknown> | undefined
+  const openai = Bun.serve({
+    port: 0,
+    fetch: (request, server) => (server.upgrade(request) ? undefined : new Response('no', { status: 400 })),
+    websocket: {
+      open: socket => {
+        voice = socket
+      },
+      message(socket, raw) {
+        const event = JSON.parse(String(raw))
+        if (event.type === 'session.start') socket.send(JSON.stringify({ type: 'session.started', session: { id: 'sess_phone', expires_at: Date.now() / 1000 + 3600 } }))
+        if (event.type === 'session.input_audio.append') audio.push(event.audio)
+        if (event.type === 'session.close') socket.send(JSON.stringify({ type: 'session.closed', reason: 'close_requested', client_event_id: event.event_id }))
+      },
+    },
+  })
+  const port = 20000 + Math.floor(Math.random() * 20000)
+  writeFileSync(
+    join(state, '.env'),
+    [`OPENAI_API_KEY=test`, `OPENAI_BASE_URL=http://127.0.0.1:${openai.port}/v1`, `VOICE_PORT=${port}`, `TWILIO_ACCOUNT_SID=AC1`, `TWILIO_AUTH_TOKEN=${TWILIO_TOKEN}`, `TWILIO_NUMBER=+15550002222`, `CALLER_NUMBER=${CALLER}`, `VOICE_PUBLIC_URL=${HOST}`].join('\n'),
+  )
+  const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => !/^(VOICE|TWILIO|OPENAI|CALLER|HEX)_/.test(key)))
+  const plugin = Bun.spawn(['bun', join(import.meta.dir, 'server.ts')], { env: { ...env, HOME: home }, stdin: 'pipe', stdout: 'ignore', stderr: 'ignore' })
+  const base = `http://127.0.0.1:${port}`
+  for (let i = 0; i < 100; i++) {
+    if (await fetch(`${base}/calls`).then(r => r.ok, () => false)) break
+    await Bun.sleep(50)
+  }
+  return {
+    base,
+    audio,
+    say: (who: 'you' | 'voice', delta: string, start_ms: number) =>
+      voice!.send(JSON.stringify({ type: who === 'you' ? 'session.input_transcript.delta' : 'session.output_transcript.delta', delta, start_ms, end_ms: start_ms + 300 })),
+    [Symbol.asyncDispose]: async () => {
+      plugin.kill()
+      await plugin.exited
+      openai.stop(true)
+      rmSync(home, { recursive: true, force: true })
+    },
+  }
+}
+
+async function dialIn(base: string) {
+  const form = new URLSearchParams({ From: CALLER, CallSid: 'CA1' })
+  const signature = createHmac('sha1', TWILIO_TOKEN).update(`https://${HOST}/twilio/incoming${[...form.keys()].sort().map(key => key + form.get(key)).join('')}`).digest('base64')
+  const twiml = await fetch(`${base}/twilio/incoming`, { method: 'POST', body: form, headers: { 'x-twilio-signature': signature } }).then(r => r.text())
+  const [, token] = twiml.match(/\/twilio\/([\w-]+)"/)!
+  const phone = new WebSocket(`${base.replace('http', 'ws')}/twilio/${token}`)
+  await new Promise(resolve => (phone.onopen = resolve))
+  phone.send(JSON.stringify({ event: 'start', start: { streamSid: 'MZ1' } }))
+  return phone
+}
+
+async function live(base: string) {
+  for (let i = 0; i < 100; i++) {
+    const { live } = await fetch(`${base}/calls`).then(r => r.json())
+    if (live) return live as string
+    await Bun.sleep(50)
+  }
+  throw new Error('the phone call never went live')
+}
+
+test("a phone call's words reach the app as they're heard, and how it ended lands in its record", async () => {
+  await using call = await phoneCall()
+  const phone = await dialIn(call.base)
+  const id = await live(call.base)
+  expect(id).toBe('sess_phone')
+
+  phone.send(JSON.stringify({ event: 'media', media: { payload: 'f39/fw==' } }))
+  const first = await fetch(`${call.base}/calls/${id}`).then(r => r.json())
+  expect(first).toMatchObject({ from: 'phone-in', turns: [] })
+  expect(typeof first.version).toBe('number')
+
+  const waiting = fetch(`${call.base}/calls/${id}?after=${first.version}`).then(r => r.json())
+  await Bun.sleep(100)
+  call.say('you', 'is the build ', 1000)
+  const heard = await waiting
+  expect(heard.turns).toEqual([{ who: 'you', at: 1000, text: 'is the build' }])
+  expect(heard.version).toBeGreaterThan(first.version)
+
+  call.say('you', 'green?', 1300)
+  call.say('voice', 'One sec.', 2500)
+  await Bun.sleep(100)
+  const later = await fetch(`${call.base}/calls/${id}?after=${heard.version}`).then(r => r.json())
+  expect(later.turns).toEqual([
+    { who: 'you', at: 1000, text: 'is the build green?' },
+    { who: 'voice', at: 2500, text: 'One sec.' },
+  ])
+  expect(call.audio).toEqual(['f39/fw=='])
+
+  const ending = fetch(`${call.base}/calls/${id}?after=${later.version}`).then(r => r.json())
+  phone.send(JSON.stringify({ event: 'stop' }))
+  const ended = await ending
+  expect(ended).toMatchObject({ id, from: 'phone-in', end: 'you' })
+  expect(ended.ended).toBeString()
+  expect(ended.version).toBeUndefined()
+  expect(ended.turns).toHaveLength(2)
+  expect((await fetch(`${call.base}/calls`).then(r => r.json())).live).toBeUndefined()
+}, 20_000)
diff --git a/external_plugins/voice/relay.ts b/external_plugins/voice/relay.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7619ff886830c93cc512bf50df04b01239e22c35
--- /dev/null
+++ b/external_plugins/voice/relay.ts
@@ -0,0 +1,12 @@
+import { connect } from 'net'
+import { join } from 'path'
+
+// One line to a hex app's hub, the way hex's own tools and sessions reach it.
+export function relay(state: string, app: string, message: object) {
+  const path = join(state, app, 'hub.sock')
+  return new Promise<void>((resolve, reject) => {
+    const socket = connect(path)
+    socket.on('connect', () => socket.end(JSON.stringify(message) + '\n', resolve))
+    socket.on('error', error => reject(new Error(`hex's hub isn't answering at ${path} (${error.message})`)))
+  })
+}
diff --git a/external_plugins/voice/t3.ts b/external_plugins/voice/t3.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e0935b518cacfbebef18fdaec0f46a82a4a70f2
--- /dev/null
+++ b/external_plugins/voice/t3.ts
@@ -0,0 +1,186 @@
+import { Database } from 'bun:sqlite'
+import { createHash } from 'crypto'
+import { existsSync, watch } from 'fs'
+import { homedir } from 'os'
+import { basename, dirname, join } from 'path'
+
+// app: where it's stuck, t3 or hex itself. request: what hex's General is asked to do about it; without one,
+// the action just puts it away.
+export type Stuck = { id: string; app: string; title: string; why: string; action: string; mark: 'paused' | 'failed'; at: string; request?: string }
+// topic: the T3 project it finished in, or the thread's own title. where says the same as one line, for apps
+// that still read it.
+export type Fresh = { id: string; app: string; topic: string; title: string; where: string; line: string; at: string }
+
+type Thread = { id: string; title: string; project: string | null; visited: string | null; limit: string | null; mine: boolean }
+type Run = { thread: string; ordinal: number; status: string; requested: string; completed: string | null }
+
+const DATABASE = join(homedir(), '.t3', 'userdata', 'statev2.sqlite')
+const RECENT = 2 * 24 * 60 * 60_000
+const QUEUED = 30 * 60_000
+
+// T3 Code's own records, read only: which threads wait on a usage limit, have a run queued that
+// never started, or ended in an error you haven't seen; and which of your threads finished since
+// you last opened them. It reads again whenever T3 Code writes its database.
+export class T3 {
+  stuck: Stuck[] = []
+  fresh: Fresh[] = []
+  private db?: Database
+  private pending?: ReturnType<typeof setTimeout>
+  private watcher?: ReturnType<typeof watch>
+
+  constructor(
+    private changed: () => void,
+    private path = DATABASE,
+  ) {
+    if (!existsSync(path)) return
+    this.db = new Database(path, { readonly: true })
+    this.watcher = watch(dirname(path), (_, file) => file?.startsWith(basename(path)) && this.schedule())
+    this.read()
+  }
+
+  close() {
+    clearTimeout(this.pending)
+    this.watcher?.close()
+    this.db?.close()
+  }
+
+  private schedule() {
+    clearTimeout(this.pending)
+    this.pending = setTimeout(() => this.read(), 500)
+  }
+
+  private read() {
+    try {
+      const { stuck, fresh } = this.query(Date.now())
+      if (JSON.stringify({ stuck, fresh }) === JSON.stringify({ stuck: this.stuck, fresh: this.fresh })) return
+      this.stuck = stuck
+      this.fresh = fresh
+      this.changed()
+    } catch (error) {
+      process.stderr.write(`voice: t3: couldn't read ${this.path}: ${error}\n`)
+    }
+  }
+
+  query(now: number) {
+    const db = this.db!
+    const threads = new Map(
+      db
+        .query<Thread, []>(
+          `select t.thread_id id, t.title, p.title project,
+             json_extract(t.payload_json, '$.lastVisitedAt') visited,
+             json_extract(t.payload_json, '$.limitRecovery.resetAt') "limit",
+             json_extract(t.payload_json, '$.createdBy') = 'user' mine
+           from orchestration_v2_projection_threads t left join projection_projects p using (project_id)
+           where t.archived_at is null and t.deleted_at is null`,
+        )
+        .all()
+        .map(thread => [thread.id, thread]),
+    )
+    const latest = db
+      .query<Run, []>(
+        `select r.thread_id thread, r.ordinal, r.status, r.requested_at requested, r.completed_at completed
+         from orchestration_v2_projection_runs r
+         join (select thread_id, max(ordinal) ordinal from orchestration_v2_projection_runs group by thread_id) m using (thread_id, ordinal)`,
+      )
+      .all()
+    const queued = db
+      .query<Run, []>(`select thread_id thread, min(requested_at) requested from orchestration_v2_projection_runs where status = 'queued' group by thread_id`)
+      .all()
+    const iso = new Date(now).toISOString()
+    const recent = new Date(now - RECENT).toISOString()
+    const stuck: Stuck[] = []
+
+    const parked = [...threads.values()].filter(thread => thread.limit && thread.limit > iso)
+    if (parked.length) {
+      const until = parked.map(thread => thread.limit!).sort()[0]!
+      stuck.push({
+        id: `t3-limit-${until}`,
+        app: 't3',
+        title: `${count(parked.length, 'T3 thread')} ${parked.length === 1 ? 'waits' : 'wait'} for ${day(until)}`,
+        why: `A usage limit: ${parked.map(thread => thread.title).join(', ')}.`,
+        action: 'Switch plan',
+        mark: 'paused',
+        at: until,
+        request: `These T3 Code threads are parked on a usage limit until ${day(until)}: ${parked.map(thread => `"${thread.title}"`).join(', ')}. Switch them to a plan with room so they carry on now.`,
+      })
+    }
+    for (const run of queued) {
+      const thread = threads.get(run.thread)
+      if (!thread || thread.limit && thread.limit > iso || Date.parse(run.requested) > now - QUEUED) continue
+      stuck.push({
+        id: `t3-queued-${digest(`${run.thread}:${run.requested}`)}`,
+        app: 't3',
+        title: `${thread.title}: queued since ${day(run.requested)}`,
+        why: 'Its run never started.',
+        action: 'Resume',
+        mark: 'paused',
+        at: run.requested,
+        request: `The T3 Code thread "${thread.title}" (${run.thread}) has had a run queued since ${run.requested} that never started. Get it going.`,
+      })
+    }
+    const failed = latest.filter(run => {
+      const thread = threads.get(run.thread)
+      return thread && run.status === 'failed' && !(thread.limit && thread.limit > iso) && run.completed! > recent && run.completed! > (thread.visited ?? '')
+    })
+    if (failed.length) {
+      const titles = failed.map(run => threads.get(run.thread)!.title)
+      stuck.push({
+        id: `t3-failed-${digest(failed.map(run => `${run.thread}:${run.ordinal}`).sort().join(','))}`,
+        app: 't3',
+        title: failed.length === 1 ? `${titles[0]} ended in an error` : `${failed.length} T3 runs ended in an error`,
+        why: failed.length === 1 ? 'You haven’t opened it since.' : `${titles.join(', ')}.`,
+        action: 'Look',
+        mark: 'failed',
+        at: failed.map(run => run.completed!).sort().at(-1)!,
+        request: `These T3 Code runs ended in an error and nobody has looked since: ${failed.map(run => `"${threads.get(run.thread)!.title}" (${run.thread})`).join(', ')}. See whether their work landed anyway; settle the ones that did and get the rest going again.`,
+      })
+    }
+
+    const fresh = latest
+      .filter(run => {
+        const thread = threads.get(run.thread)
+        return thread?.mine && run.status === 'completed' && run.completed! > recent && run.completed! > (thread.visited ?? '')
+      })
+      .sort((a, b) => b.completed!.localeCompare(a.completed!))
+      .map((run): Fresh => {
+        const thread = threads.get(run.thread)!
+        return {
+          id: `t3-done-${digest(`${run.thread}:${run.ordinal}`)}`,
+          app: 't3',
+          topic: thread.project ?? thread.title,
+          title: thread.title,
+          where: thread.project ? `T3 · ${thread.project}` : 'T3',
+          line: this.lastWords(run.thread),
+          at: run.completed!,
+        }
+      })
+    return { stuck, fresh }
+  }
+
+  // The thread's last answer, its first plain line.
+  private lastWords(thread: string) {
+    const row = this.db!
+      .query<{ text: string | null }, [string]>(
+        `select json_extract(payload_json, '$.text') text from orchestration_v2_projection_messages
+         where thread_id = ? and role = 'assistant' order by created_at desc limit 1`,
+      )
+      .get(thread)
+    const line = (row?.text ?? '')
+      .split('\n')
+      .map(line => line.replace(/^(#+|[-*>]|\d+\.)\s+/, '').replace(/\*\*|__|`/g, '').trim())
+      .find(Boolean)
+    return line ? (line.length > 200 ? `${line.slice(0, 199)}…` : line) : ''
+  }
+}
+
+function digest(text: string) {
+  return createHash('sha256').update(text).digest('hex').slice(0, 12)
+}
+
+function count(n: number, noun: string) {
+  return `${n} ${noun}${n === 1 ? '' : 's'}`
+}
+
+function day(iso: string) {
+  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
+}
diff --git a/external_plugins/voice/tasks.test.ts b/external_plugins/voice/tasks.test.ts
