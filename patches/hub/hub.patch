+
+export function free(): Promise<void> {
+  return new Promise(resolve => (onCall.size ? hungUp.push(resolve) : resolve()))
+}
+
+function hangUp(run: Run) {
+  if (onCall.delete(run) && !onCall.size) for (const resolve of hungUp.splice(0)) resolve()
+}
