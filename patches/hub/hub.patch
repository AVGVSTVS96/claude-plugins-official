+      fail(thread, error instanceof Error ? error.message : String(error))
+    }
+  }
+
+  function watchJob(thread: string, job: string) {
+    const phase = runOf(thread).phase
+    if (phase.is !== 'launching') return
+    phase.job = job
+    recover(thread)
