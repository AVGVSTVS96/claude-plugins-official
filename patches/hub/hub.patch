+export async function transcribe(recording: () => Promise<string>): Promise<string | undefined> {
+  const { TRANSCRIBE_URL: url, TRANSCRIBE_MODEL: model, TRANSCRIBE_API_KEY: key } = process.env
+  if (!url || !model) return
