+      }
+      case 'handoff': {
+        const to = args.to as string
+        const name = args.title ? title(args.title as string) : ch.name
+        const target = await move(hub, thread, to, name)
+        await ch.send(`Moved to ${to}: ${target}`)
+        await ch.setArchived(true)
